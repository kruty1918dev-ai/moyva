#!/usr/bin/env python3
import json,re,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[2]
PRESETS=ROOT/'Assets/Moyva/Presets'
def docs():
    for f in PRESETS.rglob('*.json'):
        if 'Schemas' in f.parts or 'MoyvaConfigGenerated' in f.parts: continue
        try: d=json.loads(f.read_text(encoding='utf-8'))
        except: continue
        if isinstance(d,dict) and all(k in d for k in ('schema','id','model')): yield f,d
def validate():
    seen=set(); errors=[]; n=0
    for f,d in docs():
        n+=1; key=(d.get('model'),d.get('id'))
        if key in seen: errors.append(f'duplicate {key}')
        seen.add(key)
        sp=d.get('$schema');
        if not sp or not (f.parent/sp).resolve().exists(): errors.append(f'{f}: missing schema {sp}')
    print(f'JSON documents: {n}'); print(f'Duplicate IDs: {sum(1 for e in errors if e.startswith("duplicate"))}'); print(f'Errors: {len(errors)}')
    for e in errors[:30]: print(' -',e)
    return 1 if errors else 0
def main(argv):
    if len(argv)<2 or argv[1] in ('-h','--help'):
        print('moyva-json validate | list <domain> | inspect <id> | references <id> | new <domain> <id>'); return 0
    cmd=argv[1]
    if cmd=='validate': return validate()
    if cmd=='list':
        domain=(argv[2] if len(argv)>2 else '').lower();
        for f,d in docs():
            if not domain or domain in d.get('schema','').lower() or domain in str(f.parent).lower(): print(d['id'],'\t',d['schema'],'\t',f.relative_to(ROOT))
        return 0
    if cmd=='inspect' and len(argv)>2:
        q=argv[2].lower();
        for f,d in docs():
            if str(d.get('id','')).lower()==q: print(json.dumps(d,ensure_ascii=False,indent=2)); return 0
        print('not found',q,file=sys.stderr); return 2
    if cmd=='references' and len(argv)>2:
        q=argv[2];
        for f,d in docs():
            if q in json.dumps(d,ensure_ascii=False): print(f.relative_to(ROOT))
        return 0
    if cmd=='new' and len(argv)>3:
        domain=argv[2].lower(); idv=argv[3].lower();
        if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*',idv): print('invalid id',file=sys.stderr); return 2
        mapping={'building':('Buildings','moyva.building','building.schema.json','building-definition'),'unit':('Units','moyva.unit','unit.schema.json','unit-class'),'graph':('Graphs','moyva.generator-graph','generator-graph.schema.json','graph')}
        if domain not in mapping: print('supported domains: building unit graph',file=sys.stderr); return 2
        folder,schema,schemafile,model=mapping[domain]; f=PRESETS/folder/(idv+'.json'); f.parent.mkdir(parents=True,exist_ok=True)
        if f.exists(): print('exists',f,file=sys.stderr); return 2
        d={'$schema':'../Schemas/'+schemafile,'schema':schema,'version':1,'id':idv,'model':model}
        f.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n',encoding='utf-8'); print(f.relative_to(ROOT)); return 0
    print('invalid command',file=sys.stderr); return 2
if __name__=='__main__': raise SystemExit(main(sys.argv))

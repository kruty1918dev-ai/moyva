Screen { background: #0b1120; color: #e2e8f0; }
Header { background: #14213a; color: #67e8f9; }
Footer { background: #14213a; }
#shell { height: 1fr; }
#sidebar { width: 24; background: #101a2d; padding: 1; border-right: solid #263954; }
#brand { color: #67e8f9; text-style: bold; height: 4; padding-left: 1; }
#navigation { height: 1fr; border: none; background: #101a2d; }
#ownership-note { height: auto; color: #94a3b8; padding: 1; }
#pages { width: 1fr; }
.page { padding: 1 2; }
.page-title { text-style: bold; color: #f8fafc; margin-bottom: 1; height: 2; }
.section-title { text-style: bold; color: #67e8f9; margin-top: 1; }
.field-title { text-style: bold; color: #cbd5e1; margin: 1 0 0 0; }
.card { background: #14213a; padding: 1 2; margin-bottom: 1; height: auto; border: round #263954; }
.hint-card { background: #101a2d; color: #94a3b8; padding: 1 2; margin: 0 0 1 0; border-left: thick #22d3ee; height: auto; }
.active-card { background: #10243a; padding: 1 2; margin-bottom: 1; height: auto; min-height: 8; border: round #22d3ee; }
.progress-label { color: #cbd5e1; height: auto; margin-top: 1; }
Button { margin-right: 1; min-width: 12; }
Button:disabled { opacity: 45%; }
DataTable { height: 15; margin-bottom: 1; background: #101a2d; }
#runs-table, #checkpoints-table { height: 18; }
.technical-table, .technical-only { display: none; }
#reward-chart { height: 4; color: #34d399; background: #14213a; margin-bottom: 1; }
#secondary-charts { height: 3; margin-bottom: 1; }
#secondary-charts Sparkline { width: 1fr; color: #a78bfa; margin-right: 1; }
#simple-run-row { height: 3; margin-bottom: 1; }
#simple-run-row Label { width: 24; padding-top: 1; }
#simple-run-row Input { width: 1fr; }
.simple-start-actions { height: 4; layout: grid; grid-size: 3; grid-columns: 1fr 1fr 1fr; grid-rows: 3; margin-bottom: 1; }
.advanced-hidden { display: none; }
#training-advanced { border: round #263954; padding: 1; margin-bottom: 1; }
#training-fields { layout: grid; grid-size: 4; grid-columns: 27 1fr 24 1fr; grid-rows: 3; height: auto; }
#training-fields Label { padding-top: 1; }
#training-fields Input, #training-fields Select { width: 1fr; min-width: 16; }
#field-results, #field-trainer { min-width: 28; }
.advanced-actions { height: 4; layout: grid; grid-size: 4; grid-columns: 1fr 1fr 1fr 1fr; grid-rows: 3; }
#training-progress { margin: 0 0 1 0; }
.active-actions-simple { height: 7; layout: grid; grid-size: 3 2; grid-columns: 1fr 1fr 1fr; grid-rows: 3 3; margin-bottom: 1; }
#training-log-panel { margin-bottom: 1; }
#training-log { height: 14; min-height: 8; background: #101a2d; border: round #263954; }
.home-actions { height: 4; layout: grid; grid-size: 3; grid-columns: 1fr 1fr 1fr; grid-rows: 3; margin-bottom: 1; }
.history-actions { height: 4; layout: grid; grid-size: 5; grid-columns: 1fr 1fr 1fr 1fr 1fr; grid-rows: 3; margin-bottom: 1; }
.advanced-history-actions { height: 4; layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-rows: 3; margin-bottom: 1; }
.model-actions { height: 4; layout: grid; grid-size: 4; grid-columns: 1fr 1fr 1fr 1fr; grid-rows: 3; margin-bottom: 1; }
.advanced-model-actions { height: 4; layout: grid; grid-size: 5; grid-columns: 1fr 1fr 1fr 1fr 1fr; grid-rows: 3; margin-bottom: 1; }
.tool-actions { height: auto; min-height: 4; layout: grid; grid-size: 5; grid-columns: 1fr 1fr 1fr 1fr 1fr; grid-rows: 3; margin-bottom: 1; }
RichLog { height: 18; min-height: 10; background: #101a2d; border: round #263954; }
#settings-json { height: 20; margin-bottom: 1; }
Prompt, Details, ExitTrainingDialog { align: center middle; background: #050912 80%; }
#dialog { width: 76; height: auto; padding: 2; background: #14213a; border: thick #22d3ee; }
#exit-dialog { width: 84; height: auto; padding: 2; background: #14213a; border: thick #f59e0b; }
#exit-dialog Button { margin-bottom: 1; width: 1fr; }
#prompt-title { height: auto; margin-bottom: 1; }
#dialog Input { margin: 1 0; }
#details-dialog { width: 90%; height: 85%; background: #14213a; border: thick #22d3ee; padding: 1 2; }
#details-text { height: 1fr; margin-bottom: 1; }

          _heatWeight: 0.25
          _lightWeight: 0.1
          _clothingWeight: 0.1
          _taxWeight: 0.1
          _lawWeight: 0.1
        _ageConsumption:
        - _label: Child
          _minAge: 0
          _maxAge: 15
          _foodPerTurn: 0.6
          _waterPerTurn: 0.7
          _firewoodPerTurn: 0.4
          _clothingPerTurn: 0.2
        - _label: Adult
          _minAge: 16
          _maxAge: 59
          _foodPerTurn: 1
          _waterPerTurn: 1
          _firewoodPerTurn: 0.7
          _clothingPerTurn: 0.3
        - _label: Elder
          _minAge: 60
          _maxAge: 200
          _foodPerTurn: 0.8
          _waterPerTurn: 0.9
          _firewoodPerTurn: 0.8
          _clothingPerTurn: 0.35
        _deficitPenalties:
          _foodOrWaterHpDelta: -2

        - _resourceId: Stone
          _basePrice: 6
        - _resourceId: Grain
          _basePrice: 5
        - _resourceId: Meat
          _basePrice: 8
        - _resourceId: Berries
          _basePrice: 6
        - _resourceId: Water
          _basePrice: 3
        - _resourceId: Coal
          _basePrice: 9
        - _resourceId: Clothing
          _basePrice: 12

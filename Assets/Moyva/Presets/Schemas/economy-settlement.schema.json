{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/economy-settlement.schema.json",
  "title": "Moyva — Economy Settlement Definition",
  "description": "JSON source of truth для Kruty1918.Moyva.Economy.API.EconomySettlementDefinition. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.economy-settlement"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "economy-settlement"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "settlementId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Settlement Id"
    },
    "settlementType": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Village|Castle))$",
      "x-enumNames": [
        "Village",
        "Castle"
      ],
      "x-flags": false,
      "title": "Settlement Type"
    },
    "centerBuildingId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Center Building Id"
    },
    "buildRadius": {
      "type": "integer",
      "title": "Build Radius"
    }
  }
}

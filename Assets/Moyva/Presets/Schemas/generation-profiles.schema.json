{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/generation-profiles.schema.json",
  "title": "Moyva — Generation Profiles Config",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.API.GenerationProfilesConfig. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.generation-profiles"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "generation-profiles"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "defaultProfileId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Default Profile Id"
    },
    "profiles": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "title": "Id"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "terrain": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "singleSolidTile": {
                "type": "boolean",
                "title": "Single Solid Tile"
              }
            },
            "additionalProperties": false,
            "title": "Terrain"
          },
          "water": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "pattern": "^(?:-?\\d+|(?:Full|SimpleQuad))$",
                "x-enumNames": [
                  "Full",
                  "SimpleQuad"
                ],
                "x-flags": false,
                "title": "Mode"
              },
              "material": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
                "properties": {
                  "$asset": {
                    "type": "string",
                    "title": "Asset ID"
                  },
                  "editorPath": {
                    "type": "string",
                    "description": "Editor-only path для діагностики/регенерації catalog."
                  },
                  "required": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "$asset"
                ],
                "title": "Material"
              },
              "surfaceOffsetMeters": {
                "type": "number",
                "title": "Surface Offset Meters"
              },
              "emitBed": {
                "type": "boolean",
                "title": "Emit Bed"
              }
            },
            "additionalProperties": false,
            "title": "Water"
          },
          "decorations": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "configId": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "Config Id"
              }
            },
            "additionalProperties": false,
            "title": "Decorations"
          }
        },
        "additionalProperties": false
      },
      "title": "Profiles"
    }
  }
}

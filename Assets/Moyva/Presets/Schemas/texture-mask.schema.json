{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/texture-mask.schema.json",
  "title": "Moyva — Texture Mask Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.TextureMaskNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.texture-mask"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "texture-mask"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "texture": {
      "type": [
        "object",
        "null"
      ],
      "description": "Текстура за замовчуванням, якщо вхід Texture не підключено.",
      "properties": {
        "$asset": {
          "type": "string",
          "title": "Asset ID"
        },
        "editorPath": {
          "type": "string",
          "description": "Editor-only path для діагностики/регенерації catalog."
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "$asset"
      ],
      "title": "Texture"
    },
    "channel": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Luminance|Red|Green|Blue|Alpha))$",
      "x-enumNames": [
        "Luminance",
        "Red",
        "Green",
        "Blue",
        "Alpha"
      ],
      "x-flags": false,
      "title": "Channel",
      "description": "Канал текстури, який використовується як значення 0..1."
    },
    "sampling": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Nearest|Bilinear))$",
      "x-enumNames": [
        "Nearest",
        "Bilinear"
      ],
      "x-flags": false,
      "title": "Sampling",
      "description": "Явний алгоритм зміни розміру текстури до сітки карти."
    },
    "threshold": {
      "type": "number",
      "title": "Threshold",
      "description": "Порогове значення для булевої маски.",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "invert": {
      "type": "boolean",
      "title": "Invert",
      "description": "Інвертувати булеву маску після застосування порогу."
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

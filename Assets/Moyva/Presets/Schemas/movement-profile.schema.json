{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/movement-profile.schema.json",
  "title": "Moyva — Movement Profile Config",
  "description": "JSON source of truth для Kruty1918.Moyva.Grid.API.MovementProfileConfig. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.movement-profile"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "movement-profile"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "fallback": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "passable": {
          "type": "boolean",
          "title": "Passable"
        },
        "staminaCost": {
          "type": "number",
          "title": "Stamina Cost",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        }
      },
      "additionalProperties": false,
      "title": "Fallback"
    },
    "classRules": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "classId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Class Id"
          },
          "passable": {
            "type": "boolean",
            "title": "Passable"
          },
          "staminaCost": {
            "type": "number",
            "title": "Stamina Cost",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          }
        },
        "additionalProperties": false
      },
      "title": "Class Rules"
    },
    "tileOverrides": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "tileTypeId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Tile Type Id"
          },
          "passable": {
            "type": "boolean",
            "title": "Passable"
          },
          "staminaCost": {
            "type": "number",
            "title": "Stamina Cost",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          }
        },
        "additionalProperties": false
      },
      "title": "Tile Overrides"
    },
    "heightLimits": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "autoStepMaxMeters": {
          "type": "number",
          "title": "Auto Step Max Meters",
          "description": "Largest surface delta a unit crosses by plain walking. 0.25 matches one terrace step.",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "stairModuleRiseMeters": {
          "type": "number",
          "title": "Stair Module Rise Meters",
          "description": "Rise covered by one authored stair module.",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "maxStairRiseMeters": {
          "type": "number",
          "title": "Max Stair Rise Meters",
          "description": "Largest total rise a stair flight may cover for this profile.",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        }
      },
      "additionalProperties": false,
      "title": "Height Limits"
    }
  }
}

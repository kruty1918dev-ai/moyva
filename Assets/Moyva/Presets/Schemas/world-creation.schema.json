{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/world-creation.schema.json",
  "title": "Moyva — World Creation Defaults SO",
  "description": "JSON source of truth для Kruty1918.Moyva.WorldCreation.API.WorldCreationDefaultsSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.world-creation"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "world-creation-defaults"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "defaultWorldName": {
      "type": [
        "string",
        "null"
      ],
      "title": "Default World Name",
      "description": "Назва нового світу за замовчуванням."
    },
    "appendIndexWhenSaveExists": {
      "type": "boolean",
      "title": "Append Index When Save Exists",
      "description": "Якщо увімкнено, меню створення світу додасть індекс до стартової назви, коли існують попередні збереження."
    },
    "firstWorldIndex": {
      "type": "integer",
      "title": "First World Index",
      "description": "Індекс першого світу, який додається до назви, якщо потрібно уникнути дублювання.",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "defaultSizePreset": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Small|Medium|Large|Custom))$",
      "x-enumNames": [
        "Small",
        "Medium",
        "Large",
        "Custom"
      ],
      "x-flags": false,
      "title": "Default Size Preset",
      "description": "Розмір карти за замовчуванням."
    },
    "defaultCustomWidth": {
      "type": "integer",
      "title": "Default Custom Width",
      "description": "Ширина (тайли) коли вибрано Custom. Мін: 16.",
      "minimum": 16.0,
      "x-moyva-editorMinimum": 16.0
    },
    "defaultCustomHeight": {
      "type": "integer",
      "title": "Default Custom Height",
      "description": "Висота (тайли) коли вибрано Custom. Мін: 16.",
      "minimum": 16.0,
      "x-moyva-editorMinimum": 16.0
    },
    "smallWorld": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "title": "Width",
          "minimum": 16.0,
          "x-moyva-editorMinimum": 16.0
        },
        "height": {
          "type": "integer",
          "title": "Height",
          "minimum": 16.0,
          "x-moyva-editorMinimum": 16.0
        }
      },
      "additionalProperties": false,
      "title": "Small World"
    },
    "mediumWorld": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "title": "Width",
          "minimum": 16.0,
          "x-moyva-editorMinimum": 16.0
        },
        "height": {
          "type": "integer",
          "title": "Height",
          "minimum": 16.0,
          "x-moyva-editorMinimum": 16.0
        }
      },
      "additionalProperties": false,
      "title": "Medium World"
    },
    "largeWorld": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "title": "Width",
          "minimum": 16.0,
          "x-moyva-editorMinimum": 16.0
        },
        "height": {
          "type": "integer",
          "title": "Height",
          "minimum": 16.0,
          "x-moyva-editorMinimum": 16.0
        }
      },
      "additionalProperties": false,
      "title": "Large World"
    },
    "defaultMapType": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Balanced|Continental|Island|Mountain|Plains))$",
      "x-enumNames": [
        "Balanced",
        "Continental",
        "Island",
        "Mountain",
        "Plains"
      ],
      "x-flags": false,
      "title": "Default Map Type",
      "description": "Тип карти за замовчуванням."
    },
    "defaultDifficulty": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Easy|Normal|Hard|Brutal))$",
      "x-enumNames": [
        "Easy",
        "Normal",
        "Hard",
        "Brutal"
      ],
      "x-flags": false,
      "title": "Default Difficulty",
      "description": "Складність за замовчуванням."
    },
    "defaultPlayerCount": {
      "type": "integer",
      "title": "Default Player Count",
      "description": "Кількість мережевих гравців. Мін: 2, Макс: 4.",
      "minimum": 2.0,
      "maximum": 4.0,
      "x-moyva-editorMinimum": 2.0,
      "x-moyva-editorMaximum": 4.0
    },
    "defaultStartingGold": {
      "type": "integer",
      "title": "Default Starting Gold",
      "description": "Стартове золото на фракцію.",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "defaultStartingFood": {
      "type": "integer",
      "title": "Default Starting Food",
      "description": "Стартова їжа на фракцію.",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "defaultForestDensity": {
      "type": "number",
      "title": "Default Forest Density",
      "description": "Щільність лісів [0..1].",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "defaultMountainDensity": {
      "type": "number",
      "title": "Default Mountain Density",
      "description": "Щільність гір [0..1].",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "defaultWaterDensity": {
      "type": "number",
      "title": "Default Water Density",
      "description": "Щільність водних зон [0..1].",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "defaultVillageDensity": {
      "type": "number",
      "title": "Default Village Density",
      "description": "Щільність POI (сіл, таборів) [0..1].",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "defaultGenerateRivers": {
      "type": "boolean",
      "title": "Default Generate Rivers",
      "description": "Генерувати річки за замовчуванням."
    },
    "defaultGenerateBiomes": {
      "type": "boolean",
      "title": "Default Generate Biomes",
      "description": "Генерувати біоми за замовчуванням."
    },
    "defaultApplyWFC": {
      "type": "boolean",
      "title": "Default Apply WFC",
      "description": "Застосовувати WFC-полірування тайлів за замовчуванням."
    },
    "placementRulesRecipe": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "enum": [
            "adaptive-performance-settings",
            "atlas-tile-set",
            "audio-ambience",
            "audio-feedback",
            "audio-mixer-bindings",
            "audio-registry",
            "bootstrap-installer-config",
            "building-definition",
            "building-registry",
            "calendar-session-config",
            "camera-settings",
            "clouds",
            "construction-input-profile",
            "construction-placement-rules-profile",
            "construction-system-profile",
            "construction-visual-profile",
            "construction-wall-profile",
            "data-biomes",
            "data-noise",
            "economy-ai-rule",
            "economy-caravan-template",
            "economy-database",
            "economy-production",
            "economy-resource",
            "economy-rules-config",
            "economy-rules-configuration",
            "economy-settlement",
            "economy-warehouse-policy",
            "environment-decoration",
            "far-view-atmosphere",
            "fog-of-war",
            "game-session-config",
            "gameplay-motion",
            "generation-rules",
            "generator-map-recipe",
            "graphics-startup-settings",
            "height-map",
            "home-menu-config",
            "map-chunk-settings",
            "map-object-registry",
            "map-object-terrain",
            "movement-profile",
            "moyva-project-settings",
            "object-connection-rules",
            "river-data",
            "scene-audio-overrides",
            "scene-music-profile",
            "selection-highlight-settings",
            "shared-generator-settings",
            "social-links-config",
            "terrain-layer-profile",
            "tile-height-table",
            "tile-registry",
            "tile-type",
            "tile-world-creator-id-mapping",
            "unit-class",
            "unit-registry",
            "vfx-catalog",
            "wfc-data",
            "win-condition",
            "world-creation-defaults",
            "world-economy-override",
            "world-generation"
          ]
        }
      },
      "required": [
        "$type"
      ],
      "additionalProperties": true,
      "title": "Placement Rules Recipe",
      "description": "Рецепт генерації (GeneratorMapRecipe), який використовується для читання TileRegistry та параметрів рельєфу у World Defaults Editor."
    },
    "tileRegistry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "definitions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "Id"
              },
              "movementCost": {
                "type": "number",
                "title": "Movement Cost"
              },
              "tileWorldCreatorPreset": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
                "properties": {
                  "$asset": {
                    "type": "string",
                    "title": "Asset ID"
                  },
                  "editorPath": {
                    "type": "string",
                    "description": "Editor-only path для діагностики/регенерації catalog."
                  },
                  "required": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "$asset"
                ],
                "title": "Tile World Creator Preset"
              },
              "tileWorldCreatorBlueprintLayerGuid": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "Tile World Creator Blueprint Layer Guid"
              },
              "tileWorldCreatorBlueprintLayerName": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "Tile World Creator Blueprint Layer Name"
              },
              "visualPrefab": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
                "properties": {
                  "$asset": {
                    "type": "string",
                    "title": "Asset ID"
                  },
                  "editorPath": {
                    "type": "string",
                    "description": "Editor-only path для діагностики/регенерації catalog."
                  },
                  "required": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "$asset"
                ],
                "title": "Visual Prefab"
              }
            },
            "additionalProperties": false
          },
          "title": "Definitions"
        }
      },
      "additionalProperties": false,
      "title": "Tile Registry",
      "description": "Реєстр тайлів для обмежень розміщення. Якщо задано — перекриває TileRegistry з рецепту."
    },
    "blockedBuildingTileIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "Blocked Building Tile Ids",
      "description": "Tile ID, на яких не можна будувати."
    },
    "blockedBuildingHillLevelRanges": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "minLevel": {
            "type": "integer",
            "title": "Min Level",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          },
          "maxLevel": {
            "type": "integer",
            "title": "Max Level",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          }
        },
        "additionalProperties": false
      },
      "title": "Blocked Building Hill Level Ranges",
      "description": "Діапазони рівнів HillGenerator, на яких не можна будувати (включно)."
    },
    "blockedUnitTileIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "Blocked Unit Tile Ids",
      "description": "Tile ID, на яких не можна розміщувати/рухати юнітів."
    },
    "blockedUnitHillLevelRanges": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "minLevel": {
            "type": "integer",
            "title": "Min Level",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          },
          "maxLevel": {
            "type": "integer",
            "title": "Max Level",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          }
        },
        "additionalProperties": false
      },
      "title": "Blocked Unit Hill Level Ranges",
      "description": "Діапазони рівнів HillGenerator, на яких не можна розміщувати/рухати юнітів (включно)."
    }
  }
}

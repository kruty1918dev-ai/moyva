              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "model": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "$config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "nodes": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "$config": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "properties": {
                          "model": {
                            "type": "string"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "$config"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "$type": {
                        "type": "string",
                        "enum": [
                          "add",
                          "base-noise",
                          "bool-and",
                          "bool-invert",
                          "bool-or",
                          "bool-subtract",
                          "bool-value",
                          "bool-xor",
                          "cluster-scatter",
                          "constant-cell-mask",
                          "distance-field",
                          "edge-mask",
                          "float-value",
                          "graph-preview-full-map-mask",
                          "grass-card-generator",
                          "int-value",
                          "layer-mask-reference",
                          "mask-morphology",
                          "mask-relay",
                          "noise-map",
                          "normalize-map",
                          "null-output",
                          "object-layer",
                          "object-output-to-twc",
                          "object-scatter",
                          "output",
                          "perlin-noise-mask",
                          "placement-mask",
                          "range-mask",
                          "remap-map",
                          "required-relay",
                          "seed",
                          "shape-mask",
                          "shared-settings",
                          "slope-mask",
                          "smooth-map",
                          "string-value",
                          "subgraph",
                          "subgraph-input",
                          "terrace-map",
                          "texture-mask",
                          "threshold-mask",
                          "tile-settings",
                          "twc-modifier",
                          "wave-function-collapse",
                          "wrong-output-count",
                          "wrong-output-size",
                          "wrong-output-type"
                        ]
                      }
                    },
                    "required": [
                      "$type"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Moyva config: stable $config reference або inline sub-asset з allow-listed $type."
              },
              "title": "Nodes"
            },
            "connections": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connectionId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "title": "Connection Id"
                  },
                  "sourceNodeId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "title": "Source Node Id"
                  },
                  "sourcePortIndex": {
                    "type": "integer",
                    "title": "Source Port Index"
                  },
                  "targetNodeId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "title": "Target Node Id"
                  },
                  "targetPortIndex": {
                    "type": "integer",
                    "title": "Target Port Index"
                  },
                  "sourceElementIndex": {
                    "type": "integer",
                    "title": "Source Element Index"
                  }
                },
                "additionalProperties": false
              },
              "title": "Connections"
            },
            "version": {
              "type": "integer",
              "title": "Version"
            },
            "sharedSettings": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "mapWidth": {
                  "type": "integer",
                  "title": "Map Width",
                  "description": "Authoritative ширина мапи у тайлах. Коли > 0, це значення використовується і Graph Preview, і gameplay generation. 0 = дозволити runtime/menu визначати розмір.",
                  "minimum": 0.0,
                  "x-moyva-editorMinimum": 0.0
                },
                "mapHeight": {
                  "type": "integer",
                  "title": "Map Height",
                  "description": "Authoritative висота мапи у тайлах. Коли > 0, це значення використовується і Graph Preview, і gameplay generation. 0 = дозволити runtime/menu визначати розмір.",
                  "minimum": 0.0,
                  "x-moyva-editorMinimum": 0.0
                },
                "gridTopology": {
                  "type": "string",
                  "pattern": "^(?:-?\\d+|(?:Orthogonal|HexAxial|Layered))$",
                  "x-enumNames": [
                    "Orthogonal",
                    "HexAxial",
                    "Layered"
                  ],
                  "x-flags": false,
                  "title": "Grid Topology"
                },
                "projectionMode": {
                  "type": "string",
                  "pattern": "^(?:-?\\d+|(?:Isometric3DPreview|Orthographic3D))$",
                  "x-enumNames": [
                    "Isometric3DPreview",
                    "Orthographic3D"
                  ],
                  "x-flags": false,
                  "title": "Projection Mode"
                },
                "renderMode": {
                  "type": "string",
                  "pattern": "^(?:-?\\d+|(?:Mesh3DPreview|Mesh3D))$",
                  "x-enumNames": [
                    "Mesh3DPreview",
                    "Mesh3D"
                  ],
                  "x-flags": false,
                  "title": "Render Mode"
                },
                "neighborhoodMode": {
                  "type": "string",
                  "pattern": "^(?:-?\\d+|(?:Auto|Moore8|VonNeumann4|HexAxial6))$",
                  "x-enumNames": [
                    "Auto",
                    "Moore8",
                    "VonNeumann4",
                    "HexAxial6"
                  ],
                  "x-flags": false,
                  "title": "Neighborhood Mode"
                }
              },
              "additionalProperties": false,
              "title": "Shared Settings"
            },
            "globalGraphState": {
              "type": [
                "object",
                "null"
              ],

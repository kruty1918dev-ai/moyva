{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/grass-card-generator.schema.json",
  "title": "Moyva — Grass Card Generator Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.ObjectPlacement.GrassCardGeneratorNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.grass-card-generator"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "grass-card-generator"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "texture": {
      "type": [
        "object",
        "null"
      ],
      "description": "Текстура, яку використовує редактор для генерації матеріалу/префаба перекривної плоскої трав'їнної карти.",
      "properties": {
        "$asset": {
          "type": "string",
          "title": "Asset ID"
        },
        "editorPath": {
          "type": "string",
          "description": "Editor-only path для діагностики/регенерації catalog."
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "$asset"
      ],
      "title": "Texture"
    },
    "material": {
      "type": [
        "object",
        "null"
      ],
      "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
      "properties": {
        "$asset": {
          "type": "string",
          "title": "Asset ID"
        },
        "editorPath": {
          "type": "string",
          "description": "Editor-only path для діагностики/регенерації catalog."
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "$asset"
      ],
      "title": "Material"
    },
    "prefab": {
      "type": [
        "object",
        "null"
      ],
      "description": "Згенерований або ручно створений перекривний плоский префаб трави.",
      "properties": {
        "$asset": {
          "type": "string",
          "title": "Asset ID"
        },
        "editorPath": {
          "type": "string",
          "description": "Editor-only path для діагностики/регенерації catalog."
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "$asset"
      ],
      "title": "Prefab"
    },
    "tint": {
      "type": "object",
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "additionalProperties": false,
      "title": "Tint"
    },
    "alphaClip": {
      "type": "number",
      "title": "Alpha Clip",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "crossedPlanes": {
      "type": "integer",
      "title": "Crossed Planes",
      "minimum": 1.0,
      "maximum": 8.0,
      "x-moyva-editorMinimum": 1.0,
      "x-moyva-editorMaximum": 8.0
    },
    "geometryMode": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:CrossedPlanes|CameraBillboard))$",
      "x-enumNames": [
        "CrossedPlanes",
        "CameraBillboard"
      ],
      "x-flags": false,
      "title": "Geometry Mode"
    },
    "width": {
      "type": "number",
      "title": "Width",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "height": {
      "type": "number",
      "title": "Height",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "doubleSided": {
      "type": "boolean",
      "title": "Double Sided"
    },
    "windWobble": {
      "type": "boolean",
      "title": "Wind Wobble"
    },
    "colorVariation": {
      "type": "number",
      "title": "Color Variation",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

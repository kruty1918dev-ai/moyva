{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/calendar-session-config.schema.json",
  "title": "Moyva — Calendar Session Config SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Calendar.Runtime.CalendarSessionConfigSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.calendar-session-config"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "calendar-session-config"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "startYear": {
      "type": "integer",
      "title": "Start Year",
      "description": "Рік початку гри. За замовчуванням — розквіт Київської Русі (1054)."
    },
    "startMonth": {
      "type": "integer",
      "title": "Start Month",
      "description": "Місяць початку гри (1–12)."
    },
    "startDay": {
      "type": "integer",
      "title": "Start Day",
      "description": "День початку гри (1–30)."
    },
    "startHour": {
      "type": "integer",
      "title": "Start Hour",
      "description": "Година початку гри (0–23)."
    }
  }
}

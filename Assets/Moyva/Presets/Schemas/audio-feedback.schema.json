{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/audio-feedback.schema.json",
  "title": "Moyva — Audio Feedback Config",
  "description": "JSON source of truth для Kruty1918.Moyva.GameAudio.API.AudioFeedbackConfig. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.audio-feedback"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "audio-feedback"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "eventSounds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "eventName": {
            "type": [
              "string",
              "null"
            ],
            "title": "Event Name"
          },
          "soundKey": {
            "type": [
              "string",
              "null"
            ],
            "title": "Sound Key"
          },
          "context": {
            "type": [
              "string",
              "null"
            ],
            "title": "Context",
            "description": "Контекст події: 'unit:<unitTypeId>' або 'tile:<tileTypeId>'. Порожньо — будь-який."
          },
          "volumeScale": {
            "type": "number",
            "title": "Volume Scale",
            "minimum": 0.0,
            "maximum": 1.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 1.0
          },
          "atPosition": {
            "type": "boolean",
            "title": "At Position",
            "description": "Грати у 3D-позиції події, якщо вона відома."
          }
        },
        "additionalProperties": false
      },
      "title": "Event Sounds"
    },
    "uiActionSounds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "source": {
            "type": [
              "string",
              "null"
            ],
            "title": "Source"
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "title": "Status"
          },
          "actionId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Action Id"
          },
          "soundKey": {
            "type": [
              "string",
              "null"
            ],
            "title": "Sound Key"
          },
          "volumeScale": {
            "type": "number",
            "title": "Volume Scale",
            "minimum": 0.0,
            "maximum": 1.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 1.0
          }
        },
        "additionalProperties": false
      },
      "title": "Ui Action Sounds"
    },
    "uiPointerClick": {
      "type": [
        "string",
        "null"
      ],
      "title": "Ui Pointer Click"
    },
    "uiPointerDenied": {
      "type": [
        "string",
        "null"
      ],
      "title": "Ui Pointer Denied"
    },
    "uiPointerHover": {
      "type": [
        "string",
        "null"
      ],
      "title": "Ui Pointer Hover"
    },
    "uiPointerHoverEnabled": {
      "type": "boolean",
      "title": "Ui Pointer Hover Enabled"
    },
    "uiPointerHoverCooldown": {
      "type": "number",
      "title": "Ui Pointer Hover Cooldown",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "uiPointerDragTickInterval": {
      "type": "number",
      "title": "Ui Pointer Drag Tick Interval",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "uiPointerDragTick": {
      "type": [
        "string",
        "null"
      ],
      "title": "Ui Pointer Drag Tick"
    },
    "notificationInfo": {
      "type": [
        "string",
        "null"
      ],
      "title": "Notification Info"
    },
    "notificationSuccess": {
      "type": [
        "string",
        "null"
      ],
      "title": "Notification Success"
    },
    "notificationWarning": {
      "type": [
        "string",
        "null"
      ],
      "title": "Notification Warning"
    },
    "notificationError": {
      "type": [
        "string",
        "null"
      ],
      "title": "Notification Error"
    },
    "combatMusicEnabled": {
      "type": "boolean",
      "title": "Combat Music Enabled"
    },
    "combatMusicQuietSeconds": {
      "type": "number",
      "title": "Combat Music Quiet Seconds",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    }
  }
}

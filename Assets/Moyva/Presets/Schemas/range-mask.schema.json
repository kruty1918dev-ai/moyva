{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/range-mask.schema.json",
  "title": "Moyva — Range Mask Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.RangeMaskNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.range-mask"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "range-mask"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "minimum": {
      "type": "number",
      "title": "Minimum",
      "description": "Нижня межа включного діапазону."
    },
    "maximum": {
      "type": "number",
      "title": "Maximum",
      "description": "Верхня межа включного діапазону."
    },
    "invert": {
      "type": "boolean",
      "title": "Invert",
      "description": "Інвертувати результат вибору."
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

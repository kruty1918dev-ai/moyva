{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/shared-settings.schema.json",
  "title": "Moyva — Shared Settings Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.SharedSettingsNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.shared-settings"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "shared-settings"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "settings": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "$config": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "model": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "$config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "waterLikeTileIds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": "Water Like Tile Ids",
              "description": "Tile ID, які вважаються водою у всіх нодах генератора."
            },
            "riverBaseObjectId": {
              "type": [
                "string",
                "null"
              ],
              "title": "River Base Object Id",
              "description": "Базовий Object ID річки для всіх нод генератора."
            },
            "separator": {
              "type": "string",
              "title": "Separator",
              "description": "Роздільник для базового типу (Object ID та Tile ID)."
            },
            "matchBaseTypes": {
              "type": "boolean",
              "title": "Match Base Types",
              "description": "Якщо увімкнено, порівнює базовий тип (до роздільника) замість точного ID."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Спільні налаштування генератора. Реєструються у контексті і доступні всім нодам.",
      "title": "Settings"
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

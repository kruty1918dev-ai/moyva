{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/camera-settings.schema.json",
  "title": "Moyva — Camera Settings SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Camera.API.CameraSettingsSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.camera-settings"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "camera-settings"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "controlProfile": {
      "type": "object",
      "properties": {
        "moveSpeed": {
          "type": "number",
          "title": "Move Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "sprintMultiplier": {
          "type": "number",
          "title": "Sprint Multiplier",
          "description": "Camera speed multiplier while the sprint binding is held.",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "smoothTime": {
          "type": "number",
          "title": "Smooth Time",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "zoomSpeed": {
          "type": "number",
          "title": "Zoom Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "rotationSpeed": {
          "type": "number",
          "title": "Rotation Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "rotationAcceleration": {
          "type": "number",
          "title": "Rotation Acceleration",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "rotationDeceleration": {
          "type": "number",
          "title": "Rotation Deceleration",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "pointerOrbitSensitivity": {
          "type": "number",
          "title": "Pointer Orbit Sensitivity",
          "minimum": 0.001,
          "x-moyva-editorMinimum": 0.001
        },
        "closeZoomRotationMultiplier": {
          "type": "number",
          "title": "Close Zoom Rotation Multiplier",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "farZoomRotationMultiplier": {
          "type": "number",
          "title": "Far Zoom Rotation Multiplier",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "closeZoomMoveMultiplier": {
          "type": "number",
          "title": "Close Zoom Move Multiplier",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "farZoomMoveMultiplier": {
          "type": "number",
          "title": "Far Zoom Move Multiplier",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "minZoom": {
          "type": "number",
          "title": "Min Zoom",
          "minimum": 0.1,
          "x-moyva-editorMinimum": 0.1
        },
        "maxZoom": {
          "type": "number",
          "title": "Max Zoom",
          "minimum": 0.2,
          "x-moyva-editorMinimum": 0.2
        },
        "touchMoveSpeed": {
          "type": "number",
          "title": "Touch Move Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "touchPinchZoomSensitivity": {
          "type": "number",
          "title": "Touch Pinch Zoom Sensitivity",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "touchDragDeadZonePixels": {
          "type": "number",
          "title": "Touch Drag Dead Zone Pixels",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "touchPinchDeadZonePixels": {
          "type": "number",
          "title": "Touch Pinch Dead Zone Pixels",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "maxTouchDeltaPixels": {
          "type": "number",
          "title": "Max Touch Delta Pixels",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        },
        "touchPinchDominancePixels": {
          "type": "number",
          "title": "Touch Pinch Dominance Pixels",
          "description": "Accumulated pinch distance (px) after which twist is suppressed for this gesture.",
          "minimum": 0.5,
          "x-moyva-editorMinimum": 0.5
        },
        "touchTwistDominanceDegrees": {
          "type": "number",
          "title": "Touch Twist Dominance Degrees",
          "description": "Accumulated twist (degrees) after which pinch is suppressed for this gesture.",
          "minimum": 0.5,
          "x-moyva-editorMinimum": 0.5
        },
        "touchSettleFrames": {
          "type": "integer",
          "title": "Touch Settle Frames",
          "description": "Frames of one-finger pan ignored after a multi-touch gesture ends.",
          "minimum": 0.0,
          "maximum": 8.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 8.0
        },
        "useImmediateTouchGestures": {
          "type": "boolean",
          "title": "Use Immediate Touch Gestures"
        },
        "keepPinchFocusUnderFingers": {
          "type": "boolean",
          "title": "Keep Pinch Focus Under Fingers"
        }
      },
      "additionalProperties": false,
      "title": "Control Profile"
    },
    "boundsOverflowTiles": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Bounds Overflow Tiles",
      "description": "How many tile units the camera viewport is allowed to go outside map bounds."
    },
    "boundsSoftMargin": {
      "type": "number",
      "title": "Bounds Soft Margin",
      "description": "Soft-resistance zone in world units before a hard bounds stop. 0 = hard stop.",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "boundsSoftReturnSpeed": {
      "type": "number",
      "title": "Bounds Soft Return Speed",
      "description": "Elastic pull-back speed (1/s) when the target rests inside the soft margin.",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "touchDpiReference": {
      "type": "number",
      "title": "Touch Dpi Reference",
      "description": "Reference DPI for touch gesture thresholds. Thresholds scale with Screen.dpi / reference.",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "touchDpiScaleMin": {
      "type": "number",
      "title": "Touch Dpi Scale Min",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "touchDpiScaleMax": {
      "type": "number",
      "title": "Touch Dpi Scale Max",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "focus": {
      "type": "object",
      "properties": {
        "minDuration": {
          "type": "number",
          "title": "Min Duration",
          "minimum": 0.05,
          "x-moyva-editorMinimum": 0.05
        },
        "maxDuration": {
          "type": "number",
          "title": "Max Duration",
          "minimum": 0.05,
          "x-moyva-editorMinimum": 0.05
        },
        "distanceForMaxDuration": {
          "type": "number",
          "title": "Distance For Max Duration",
          "description": "Navigation-plane distance at which the transition reaches maxDuration.",
          "minimum": 0.1,
          "x-moyva-editorMinimum": 0.1
        },
        "boundsPadding": {
          "type": "number",
          "title": "Bounds Padding",
          "description": "Screen margin multiplier applied when fitting object bounds.",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        },
        "zoomChangeThreshold": {
          "type": "number",
          "title": "Zoom Change Threshold",
          "description": "Relative zoom change below which the focus transition keeps the current zoom.",
          "minimum": 0.0,
          "maximum": 0.75,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 0.75
        },
        "reducedMotionDurationScale": {
          "type": "number",
          "title": "Reduced Motion Duration Scale",
          "description": "Duration multiplier applied when Reduce Camera Motion is enabled.",
          "minimum": 0.1,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.1,
          "x-moyva-editorMaximum": 1.0
        }
      },
      "additionalProperties": false,
      "title": "Focus"
    },
    "impulse": {
      "type": "object",
      "properties": {
        "maxPositionOffset": {
          "type": "number",
          "title": "Max Position Offset",
          "description": "Absolute clamp for combined positional offset in world units.",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "maxRotationDegrees": {
          "type": "number",
          "title": "Max Rotation Degrees",
          "description": "Absolute clamp for combined rotational offset in degrees.",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "farZoomScale": {
          "type": "number",
          "title": "Far Zoom Scale",
          "description": "Impulse scale at far zoom (NormalizedZoom = 1).",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "mobileScale": {
          "type": "number",
          "title": "Mobile Scale",
          "description": "Extra impulse scale on mobile platforms.",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "reduceMotionScale": {
          "type": "number",
          "title": "Reduce Motion Scale",
          "description": "Impulse scale when Reduce Camera Motion is enabled.",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "maxConcurrent": {
          "type": "integer",
          "title": "Max Concurrent",
          "minimum": 1.0,
          "maximum": 16.0,
          "x-moyva-editorMinimum": 1.0,
          "x-moyva-editorMaximum": 16.0
        },
        "defaultFalloffRadius": {
          "type": "number",
          "title": "Default Falloff Radius",
          "description": "Default distance falloff radius in world units for positional impulses.",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        }
      },
      "additionalProperties": false,
      "title": "Impulse"
    },
    "defaultCameraZ": {
      "type": "number",
      "title": "Default Camera Z"
    },
    "adaptToProject3DMode": {
      "type": "boolean",
      "title": "Adapt To Project 3D Mode"
    },
    "useOrthographicCameraIn3D": {
      "type": "boolean",
      "title": "Use Orthographic Camera In 3D"
    },
    "default3DCameraDistance": {
      "type": "number",
      "title": "Default 3D Camera Distance",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "default3DOrthographicSize": {
      "type": "number",
      "title": "Default 3D Orthographic Size",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "default3DFieldOfView": {
      "type": "number",
      "title": "Default 3D Field Of View",
      "minimum": 1.0,
      "maximum": 179.0,
      "x-moyva-editorMinimum": 1.0,
      "x-moyva-editorMaximum": 179.0
    },
    "orthographic3DEuler": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "title": "Orthographic 3D Euler"
    },
    "isometric3DEuler": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "title": "Isometric 3D Euler"
    },
    "rotationPivotRaycastDistance": {
      "type": "number",
      "title": "Rotation Pivot Raycast Distance",
      "description": "Maximum distance for the forward ray used to find the camera rotation pivot.",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "rotationPivotLayers": {
      "type": "integer",
      "title": "Rotation Pivot Layers",
      "description": "Physics layers that can provide a camera rotation pivot. Falls back to the grid plane when nothing is hit."
    },
    "edgeScrollEnabled": {
      "type": "boolean",
      "title": "Edge Scroll Enabled",
      "description": "Disabled by default. Can be exposed by the gameplay controls settings UI."
    },
    "edgeScrollMarginPixels": {
      "type": "number",
      "title": "Edge Scroll Margin Pixels",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "edgeScrollSpeedMultiplier": {
      "type": "number",
      "title": "Edge Scroll Speed Multiplier",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "enableAutomaticMipBias": {
      "type": "boolean",
      "title": "Enable Automatic Mip Bias",
      "description": "Applies global automatic mip bias for zoom. Disable to avoid tile atlas artifacts/bleeding on zoom-out."
    },
    "automaticMipBiasMax": {
      "type": "number",
      "title": "Automatic Mip Bias Max",
      "minimum": 0.0,
      "maximum": 3.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 3.0
    },
    "farView": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "title": "Start",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "full": {
          "type": "number",
          "title": "Full",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "smoothing": {
          "type": "number",
          "title": "Smoothing",
          "minimum": 0.05,
          "x-moyva-editorMinimum": 0.05
        },
        "shape": {
          "type": "number",
          "title": "Shape",
          "minimum": 0.2,
          "maximum": 3.0,
          "x-moyva-editorMinimum": 0.2,
          "x-moyva-editorMaximum": 3.0
        }
      },
      "additionalProperties": false,
      "title": "Far View",
      "description": "Shared normalized-zoom window where the world reads as distant/high-altitude. Consumed by far-view visuals and zoom-driven audio."
    },
    "mapRenderMaskEnabled": {
      "type": "boolean",
      "title": "Map Render Mask Enabled"
    },
    "mapMaskRefreshSeconds": {
      "type": "number",
      "title": "Map Mask Refresh Seconds",
      "minimum": 0.05,
      "x-moyva-editorMinimum": 0.05
    },
    "mapMaskLayers": {
      "type": "integer",
      "title": "Map Mask Layers"
    },
    "mapMaskSortingLayerName": {
      "type": [
        "string",
        "null"
      ],
      "title": "Map Mask Sorting Layer Name"
    },
    "mapMaskBackSortingOrder": {
      "type": "integer",
      "title": "Map Mask Back Sorting Order",
      "minimum": -32768.0,
      "maximum": 32767.0,
      "x-moyva-editorMinimum": -32768.0,
      "x-moyva-editorMaximum": 32767.0
    },
    "mapMaskFrontSortingOrder": {
      "type": "integer",
      "title": "Map Mask Front Sorting Order",
      "minimum": -32768.0,
      "maximum": 32767.0,
      "x-moyva-editorMinimum": -32768.0,
      "x-moyva-editorMaximum": 32767.0
    },
    "manualMapMaskCenter": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Manual Map Mask Center"
    },
    "manualMapMaskSize": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Manual Map Mask Size"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/camera-settings.schema.json",
  "title": "Moyva — Camera Settings SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Camera.API.CameraSettingsSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.camera-settings"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "camera-settings"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "controlProfile": {
      "type": "object",
      "properties": {
        "moveSpeed": {
          "type": "number",
          "title": "Move Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "smoothTime": {
          "type": "number",
          "title": "Smooth Time",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "zoomSpeed": {
          "type": "number",
          "title": "Zoom Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "rotationSpeed": {
          "type": "number",
          "title": "Rotation Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "rotationAcceleration": {
          "type": "number",
          "title": "Rotation Acceleration",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "rotationDeceleration": {
          "type": "number",
          "title": "Rotation Deceleration",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "pointerOrbitSensitivity": {
          "type": "number",
          "title": "Pointer Orbit Sensitivity",
          "minimum": 0.001,
          "x-moyva-editorMinimum": 0.001
        },
        "closeZoomRotationMultiplier": {
          "type": "number",
          "title": "Close Zoom Rotation Multiplier",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "farZoomRotationMultiplier": {
          "type": "number",
          "title": "Far Zoom Rotation Multiplier",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "minZoom": {
          "type": "number",
          "title": "Min Zoom",
          "minimum": 0.1,
          "x-moyva-editorMinimum": 0.1
        },
        "maxZoom": {
          "type": "number",
          "title": "Max Zoom",
          "minimum": 0.2,
          "x-moyva-editorMinimum": 0.2
        },
        "touchMoveSpeed": {
          "type": "number",
          "title": "Touch Move Speed",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "touchPinchZoomSensitivity": {
          "type": "number",
          "title": "Touch Pinch Zoom Sensitivity",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "touchDragDeadZonePixels": {
          "type": "number",
          "title": "Touch Drag Dead Zone Pixels",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "touchPinchDeadZonePixels": {
          "type": "number",
          "title": "Touch Pinch Dead Zone Pixels",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "maxTouchDeltaPixels": {
          "type": "number",
          "title": "Max Touch Delta Pixels",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        },
        "useImmediateTouchGestures": {
          "type": "boolean",
          "title": "Use Immediate Touch Gestures"
        },
        "keepPinchFocusUnderFingers": {
          "type": "boolean",
          "title": "Keep Pinch Focus Under Fingers"
        }
      },
      "additionalProperties": false,
      "title": "Control Profile"
    },
    "boundsOverflowTiles": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Bounds Overflow Tiles",
      "description": "How many tile units the camera viewport is allowed to go outside map bounds."
    },
    "defaultCameraZ": {
      "type": "number",
      "title": "Default Camera Z"
    },
    "adaptToProject3DMode": {
      "type": "boolean",
      "title": "Adapt To Project 3D Mode"
    },
    "useOrthographicCameraIn3D": {
      "type": "boolean",
      "title": "Use Orthographic Camera In 3D"
    },
    "default3DCameraDistance": {
      "type": "number",
      "title": "Default 3D Camera Distance",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "default3DOrthographicSize": {
      "type": "number",
      "title": "Default 3D Orthographic Size",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "default3DFieldOfView": {
      "type": "number",
      "title": "Default 3D Field Of View",
      "minimum": 1.0,
      "maximum": 179.0,
      "x-moyva-editorMinimum": 1.0,
      "x-moyva-editorMaximum": 179.0
    },
    "orthographic3DEuler": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "title": "Orthographic 3D Euler"
    },
    "isometric3DEuler": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "title": "Isometric 3D Euler"
    },
    "rotationPivotRaycastDistance": {
      "type": "number",
      "title": "Rotation Pivot Raycast Distance",
      "description": "Maximum distance for the forward ray used to find the camera rotation pivot.",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "rotationPivotLayers": {
      "type": "integer",
      "title": "Rotation Pivot Layers",
      "description": "Physics layers that can provide a camera rotation pivot. Falls back to the grid plane when nothing is hit."
    },
    "edgeScrollEnabled": {
      "type": "boolean",
      "title": "Edge Scroll Enabled",
      "description": "Disabled by default. Can be exposed by the gameplay controls settings UI."
    },
    "edgeScrollMarginPixels": {
      "type": "number",
      "title": "Edge Scroll Margin Pixels",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "edgeScrollSpeedMultiplier": {
      "type": "number",
      "title": "Edge Scroll Speed Multiplier",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "enableAutomaticMipBias": {
      "type": "boolean",
      "title": "Enable Automatic Mip Bias",
      "description": "Applies global automatic mip bias for zoom. Disable to avoid tile atlas artifacts/bleeding on zoom-out."
    },
    "automaticMipBiasMax": {
      "type": "number",
      "title": "Automatic Mip Bias Max",
      "minimum": 0.0,
      "maximum": 3.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 3.0
    },
    "mapRenderMaskEnabled": {
      "type": "boolean",
      "title": "Map Render Mask Enabled"
    },
    "mapMaskRefreshSeconds": {
      "type": "number",
      "title": "Map Mask Refresh Seconds",
      "minimum": 0.05,
      "x-moyva-editorMinimum": 0.05
    },
    "mapMaskLayers": {
      "type": "integer",
      "title": "Map Mask Layers"
    },
    "mapMaskSortingLayerName": {
      "type": [
        "string",
        "null"
      ],
      "title": "Map Mask Sorting Layer Name"
    },
    "mapMaskBackSortingOrder": {
      "type": "integer",
      "title": "Map Mask Back Sorting Order",
      "minimum": -32768.0,
      "maximum": 32767.0,
      "x-moyva-editorMinimum": -32768.0,
      "x-moyva-editorMaximum": 32767.0
    },
    "mapMaskFrontSortingOrder": {
      "type": "integer",
      "title": "Map Mask Front Sorting Order",
      "minimum": -32768.0,
      "maximum": 32767.0,
      "x-moyva-editorMinimum": -32768.0,
      "x-moyva-editorMaximum": 32767.0
    },
    "manualMapMaskCenter": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Manual Map Mask Center"
    },
    "manualMapMaskSize": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Manual Map Mask Size"
    }
  }
}

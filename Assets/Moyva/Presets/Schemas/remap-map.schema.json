{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/remap-map.schema.json",
  "title": "Moyva — Remap Map Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.RemapMapNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.remap-map"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "remap-map"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "inputMinimum": {
      "type": "number",
      "title": "Input Minimum",
      "description": "Нижня межа вхідного діапазону."
    },
    "inputMaximum": {
      "type": "number",
      "title": "Input Maximum",
      "description": "Верхня межа вхідного діапазону."
    },
    "outputMinimum": {
      "type": "number",
      "title": "Output Minimum",
      "description": "Нижня межа вихідного діапазону."
    },
    "outputMaximum": {
      "type": "number",
      "title": "Output Maximum",
      "description": "Верхня межа вихідного діапазону."
    },
    "clamp": {
      "type": "boolean",
      "title": "Clamp",
      "description": "Обмежувати нормалізоване значення діапазоном 0..1."
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

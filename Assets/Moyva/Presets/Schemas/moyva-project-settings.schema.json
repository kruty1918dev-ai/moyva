{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/moyva-project-settings.schema.json",
  "title": "Moyva — Moyva Project Settings SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Grid.API.MoyvaProjectSettingsSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.moyva-project-settings"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "moyva-project-settings"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "projectVisualMode": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Auto|Full3D))$",
      "x-enumNames": [
        "Auto",
        "Full3D"
      ],
      "x-flags": false,
      "title": "Project Visual Mode"
    },
    "useAdvancedProjectSettings": {
      "type": "boolean",
      "title": "Use Advanced Project Settings"
    },
    "defaultGridTopology": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Orthogonal|HexAxial|Layered))$",
      "x-enumNames": [
        "Orthogonal",
        "HexAxial",
        "Layered"
      ],
      "x-flags": false,
      "title": "Default Grid Topology"
    },
    "defaultProjectionMode": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Isometric3DPreview|Orthographic3D))$",
      "x-enumNames": [
        "Isometric3DPreview",
        "Orthographic3D"
      ],
      "x-flags": false,
      "title": "Default Projection Mode"
    },
    "defaultRenderMode": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Mesh3DPreview|Mesh3D))$",
      "x-enumNames": [
        "Mesh3DPreview",
        "Mesh3D"
      ],
      "x-flags": false,
      "title": "Default Render Mode"
    },
    "defaultNeighborhood": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Auto|Moore8|VonNeumann4|HexAxial6))$",
      "x-enumNames": [
        "Auto",
        "Moore8",
        "VonNeumann4",
        "HexAxial6"
      ],
      "x-flags": false,
      "title": "Default Neighborhood"
    },
    "orthogonalCellWidth": {
      "type": "number",
      "title": "Orthogonal Cell Width",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "orthogonalCellHeight": {
      "type": "number",
      "title": "Orthogonal Cell Height",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "orthogonalCellDepth": {
      "type": "number",
      "title": "Orthogonal Cell Depth",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "isometricTileWidth": {
      "type": "number",

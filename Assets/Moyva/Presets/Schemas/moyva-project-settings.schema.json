      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "isometricTileHeight": {
      "type": "number",
      "title": "Isometric Tile Height",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "hexOrientation": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:PointyTop|FlatTop))$",
      "x-enumNames": [
        "PointyTop",
        "FlatTop"
      ],
      "x-flags": false,
      "title": "Hex Orientation"
    },
    "hexRadius": {
      "type": "number",
      "title": "Hex Radius",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "heightScale": {
      "type": "number",
      "title": "Height Scale",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "useHeightForPreview": {
      "type": "boolean",
      "title": "Use Height For Preview"
    },
    "enableMeshPrefabPreviews": {
      "type": "boolean",
      "title": "Enable Mesh Prefab Previews"
    },
    "previewTextureSize": {
      "type": "integer",
      "title": "Preview Texture Size",
      "minimum": 16.0,
      "x-moyva-editorMinimum": 16.0
    },
    "previewPadding": {
      "type": "number",
      "title": "Preview Padding",
      "minimum": 1.0,
      "maximum": 3.0,
      "x-moyva-editorMinimum": 1.0,
      "x-moyva-editorMaximum": 3.0
    },
    "generatePreviewMipmaps": {
      "type": "boolean",
      "title": "Generate Preview Mipmaps"
    },
    "previewFilterMode": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Point|Bilinear|Trilinear))$",
      "x-enumNames": [
        "Point",
        "Bilinear",
        "Trilinear"
      ],
      "x-flags": false,
      "title": "Preview Filter Mode"
    },
    "previewRenderTextureFormat": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:ARGB32|Depth|ARGBHalf|Shadowmap|RGB565|ARGB4444|ARGB1555|Default|ARGB2101010|DefaultHDR|ARGB64|ARGBFloat|RGFloat|RGHalf|RFloat|RHalf|R8|ARGBInt|RGInt|RInt|BGRA32|RGB111110Float|RG32|RGBAUShort|RG16|BGRA10101010_XR|BGR101010_XR|R16))$",
      "x-enumNames": [
        "ARGB32",
        "Depth",
        "ARGBHalf",
        "Shadowmap",
        "RGB565",
        "ARGB4444",
        "ARGB1555",
        "Default",
        "ARGB2101010",
        "DefaultHDR",
        "ARGB64",
        "ARGBFloat",
        "RGFloat",
        "RGHalf",
        "RFloat",
        "RHalf",
        "R8",
        "ARGBInt",
        "RGInt",
        "RInt",
        "BGRA32",
        "RGB111110Float",
        "RG32",
        "RGBAUShort",
        "RG16",
        "BGRA10101010_XR",
        "BGR101010_XR",
        "R16"
      ],
      "x-flags": false,
      "title": "Preview Render Texture Format"
    },
    "previewRenderTextureReadWrite": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Default|Linear|sRGB))$",
      "x-enumNames": [
        "Default",
        "Linear",
        "sRGB"
      ],
      "x-flags": false,
      "title": "Preview Render Texture Read Write"
    },
    "orthographic3DPreviewEuler": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }

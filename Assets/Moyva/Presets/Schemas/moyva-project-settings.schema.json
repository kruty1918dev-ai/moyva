      "title": "Use Live Home Menu Mesh Preview"
    },
    "homeMenuPreviewIncludeObjects": {
      "type": "boolean",
      "title": "Home Menu Preview Include Objects"
    },
    "homeMenuPreviewIncludeBuildings": {
      "type": "boolean",
      "title": "Home Menu Preview Include Buildings"
    },
    "homeMenuPreviewCombineMeshesByMaterial": {
      "type": "boolean",

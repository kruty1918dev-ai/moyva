{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/building-preset-pack.schema.json",
  "title": "Moyva Building Preset Pack",
  "description": "Controls deterministic batch synchronization of building JSON presets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "packId", "requiresSchemaVersion", "applyPolicy", "applyProposedModules", "presets", "resourceAliases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "moyva.building-preset-pack" },
    "version": { "const": 1 },
    "packId": { "type": "string", "minLength": 1 },
    "requiresSchemaVersion": { "const": 1 },
    "applyPolicy": { "const": "idempotent", "description": "A second sync with unchanged JSON must produce no asset changes." },
    "applyProposedModules": { "type": "boolean" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "resourceAliases": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "Maps readable preset names to stable economy resource IDs."
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}

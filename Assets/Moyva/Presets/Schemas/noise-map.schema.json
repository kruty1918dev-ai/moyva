{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/noise-map.schema.json",
  "title": "Moyva — Noise Map Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.NoiseMapNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.noise-map"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "noise-map"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "algorithm": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Perlin|Value))$",
      "x-enumNames": [
        "Perlin",
        "Value"
      ],
      "x-flags": false,
      "title": "Algorithm",
      "description": "Алгоритм базового шуму."
    },
    "scale": {
      "type": "number",
      "title": "Scale",
      "description": "Розмір характерних деталей у клітинах.",
      "minimum": 0.0001,
      "x-moyva-editorMinimum": 0.0001
    },
    "octaves": {
      "type": "integer",
      "title": "Octaves",
      "description": "Кількість октав фрактального шуму.",
      "minimum": 1.0,
      "maximum": 12.0,
      "x-moyva-editorMinimum": 1.0,
      "x-moyva-editorMaximum": 12.0
    },
    "persistence": {
      "type": "number",
      "title": "Persistence",
      "description": "Частка амплітуди кожної наступної октави.",
      "minimum": 0.01,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.01,
      "x-moyva-editorMaximum": 1.0
    },
    "lacunarity": {
      "type": "number",
      "title": "Lacunarity",
      "description": "Множник частоти кожної наступної октави.",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "offset": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Offset",
      "description": "Просторовий зсув вибірки шуму."
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

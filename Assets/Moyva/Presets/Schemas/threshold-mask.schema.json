{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/threshold-mask.schema.json",
  "title": "Moyva — Threshold Mask Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.ThresholdMaskNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.threshold-mask"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "threshold-mask"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "threshold": {
      "type": "number",
      "title": "Threshold",
      "description": "Порогове значення."
    },
    "comparison": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:GreaterOrEqual|LessOrEqual))$",
      "x-enumNames": [
        "GreaterOrEqual",
        "LessOrEqual"
      ],
      "x-flags": false,
      "title": "Comparison",
      "description": "Напрямок порівняння з порогом."
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/vfx-catalog.schema.json",
  "title": "Moyva — Vfx Catalog Config",
  "description": "JSON source of truth для Kruty1918.Moyva.Vfx.API.VfxCatalogConfig. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.vfx-catalog"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "vfx-catalog"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "effects": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "eventName": {
            "type": [
              "string",
              "null"
            ],
            "title": "Event Name"
          },
          "context": {
            "type": [
              "string",
              "null"
            ],
            "title": "Context"
          },
          "prefab": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Prefab"
          },
          "priority": {
            "type": "integer",
            "title": "Priority",
            "description": "0 = low (ambient/dust), 1 = normal, 2 = critical (kill/capture).",
            "minimum": 0.0,
            "maximum": 2.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 2.0
          },
          "maxConcurrent": {
            "type": "integer",
            "title": "Max Concurrent",
            "description": "Одночасних інстансів цього ефекту. 0 = лише глобальний бюджет.",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          },
          "prewarm": {
            "type": "integer",
            "title": "Prewarm",
            "description": "Кількість інстансів для прогріву пулу на Initialize.",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          },
          "duration": {
            "type": "number",
            "title": "Duration",
            "description": "Тривалість до auto-return. <=0 — взяти duration із VfxEffect на префабі."
          },
          "scale": {
            "type": "number",
            "title": "Scale",
            "description": "Множник world-scale ефекту.",
            "minimum": 0.01,
            "x-moyva-editorMinimum": 0.01
          },
          "cooldownPerKey": {
            "type": "number",
            "title": "Cooldown Per Key",
            "description": "Мінімальний інтервал між спавнами з тим самим dedupeKey (наприклад unitId). 0 = без троттлингу.",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          },
          "factionTint": {
            "type": "boolean",
            "title": "Faction Tint",
            "description": "Підфарбувати tint-системи ефекту кольором фракції власника."
          },
          "cullDistance": {
            "type": "number",
            "title": "Cull Distance",
            "description": "Не спавнити, якщо подія далі за цю дистанцію від камери. 0 = без обмеження.",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          },
          "maxOrthoSize": {
            "type": "number",
            "title": "Max Ortho Size",
            "description": "Не спавнити low-priority ефект, якщо orthographicSize камери більший (далекий zoom). 0 = вимкнено.",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          }
        },
        "additionalProperties": false
      },
      "title": "Effects"
    },
    "budget": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "maxActivePerformance": {
          "type": "integer",
          "title": "Max Active Performance",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        },
        "maxActiveBalanced": {
          "type": "integer",
          "title": "Max Active Balanced",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        },
        "maxActiveQuality": {
          "type": "integer",
          "title": "Max Active Quality",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        },
        "maxSpawnsPerFrame": {
          "type": "integer",
          "title": "Max Spawns Per Frame",
          "description": "Максимум нових спавнів за один кадр (решта drop).",
          "minimum": 1.0,
          "x-moyva-editorMinimum": 1.0
        },
        "defaultCullDistance": {
          "type": "number",
          "title": "Default Cull Distance",
          "description": "Дистанція від камери, за якою не-критичні ефекти не спавняться. 0 = вимкнено.",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "lowPriorityMaxOrthoSize": {
          "type": "number",
          "title": "Low Priority Max Ortho Size",
          "description": "orthographicSize камери, за яким low-priority ефекти повністю вимикаються. 0 = вимкнено.",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        }
      },
      "additionalProperties": false,
      "title": "Budget"
    }
  }
}

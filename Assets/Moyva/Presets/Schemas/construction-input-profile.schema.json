{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/construction-input-profile.schema.json",
  "title": "Moyva — Construction Input Profile SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Construction.API.ConstructionInputProfileSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.construction-input-profile"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "construction-input-profile"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "touchTapMaxMovePixels": {
      "type": "number",
      "title": "Touch Tap Max Move Pixels"
    },
    "touchTapMaxDurationSeconds": {
      "type": "number",
      "title": "Touch Tap Max Duration Seconds"
    },
    "enableMousePendingPreviewDrag": {
      "type": "boolean",
      "title": "Enable Mouse Pending Preview Drag"
    },
    "enableTouchPendingPreviewDrag": {
      "type": "boolean",
      "title": "Enable Touch Pending Preview Drag"
    },
    "enableMultiTouchCancel": {
      "type": "boolean",
      "title": "Enable Multi Touch Cancel"
    },
    "blockInteractiveUi": {
      "type": "boolean",
      "title": "Block Interactive Ui"
    },
    "allowClicksThroughNonInteractiveUi": {
      "type": "boolean",
      "title": "Allow Clicks Through Non Interactive Ui"
    }
  }
}

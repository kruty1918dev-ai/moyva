{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/shape-mask.schema.json",
  "title": "Moyva — Shape Mask Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.ShapeMaskNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.shape-mask"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "shape-mask"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "shape": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Rectangle|Ellipse|Diamond))$",
      "x-enumNames": [
        "Rectangle",
        "Ellipse",
        "Diamond"
      ],
      "x-flags": false,
      "title": "Shape",
      "description": "Геометрична форма маски."
    },
    "center": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Center",
      "description": "Центр форми у діапазоні 0..1 по ширині та висоті."
    },
    "size": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Size",
      "description": "Розмір форми у частках ширини та висоти карти."
    },
    "invert": {
      "type": "boolean",
      "title": "Invert",
      "description": "Інвертувати результат маски."
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

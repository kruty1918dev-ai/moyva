{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/add.schema.json",
  "title": "Moyva — Add Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.AddNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.add"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "add"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "mode": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:AddOrMerge|ApplyMask|SubtractMask|OverlayBOnA|Min|Max|Subtract|Multiply|Divide|Power|Modulo))$",
      "x-enumNames": [
        "AddOrMerge",
        "ApplyMask",
        "SubtractMask",
        "OverlayBOnA",
        "Min",
        "Max",
        "Subtract",
        "Multiply",
        "Divide",
        "Power",
        "Modulo"
      ],
      "x-flags": false,
      "title": "Mode"
    },
    "valueKind": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Any|Bool|Int|Float|String|BoolMask|IntMap|FloatMap|StringMap|Vector2|Vector3|Vector2Int|Vector3Int))$",
      "x-enumNames": [
        "Any",
        "Bool",
        "Int",
        "Float",
        "String",
        "BoolMask",
        "IntMap",
        "FloatMap",
        "StringMap",
        "Vector2",
        "Vector3",
        "Vector2Int",
        "Vector3Int"
      ],
      "x-flags": false,
      "title": "Value Kind"
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

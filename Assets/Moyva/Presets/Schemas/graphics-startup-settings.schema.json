{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/graphics-startup-settings.schema.json",
  "title": "Moyva — Graphics Startup Settings SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Shared.Graphics.GraphicsStartupSettingsSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.graphics-startup-settings"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "graphics-startup-settings"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "startupSettings": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^(?:-?\\d+|(?:Auto|Performance|Balanced|Quality|Custom))$",
          "x-enumNames": [
            "Auto",
            "Performance",
            "Balanced",
            "Quality",
            "Custom"
          ],
          "x-flags": false,
          "title": "Profile"
        },
        "targetFrameRate": {
          "type": "integer",
          "title": "Target Frame Rate"
        },
        "renderScale": {
          "type": "number",
          "title": "Render Scale"
        },
        "dynamicRenderScale": {
          "type": "boolean",
          "title": "Dynamic Render Scale"
        },
        "closeZoomOptimization": {
          "type": "boolean",
          "title": "Close Zoom Optimization"
        },
        "textureMipmapLimit": {
          "type": "integer",
          "title": "Texture Mipmap Limit"
        },
        "antiAliasing": {
          "type": "integer",
          "title": "Anti Aliasing"
        },
        "vSync": {
          "type": "boolean",
          "title": "V Sync"
        },
        "shadows": {
          "type": "boolean",
          "title": "Shadows"
        },
        "anisotropicFiltering": {
          "type": "boolean",
          "title": "Anisotropic Filtering"
        },
        "lodBias": {
          "type": "number",
          "title": "Lod Bias"
        }
      },
      "additionalProperties": false,
      "title": "Startup Settings"
    },
    "zoomSettings": {
      "type": "object",
      "properties": {
        "closeZoomFullPressureOrthographicSize": {
          "type": "number",
          "title": "Close Zoom Full Pressure Orthographic Size"
        },
        "closeZoomNoPressureOrthographicSize": {
          "type": "number",
          "title": "Close Zoom No Pressure Orthographic Size"
        },
        "closeZoomFullPressureFieldOfView": {
          "type": "number",
          "title": "Close Zoom Full Pressure Field Of View"
        },
        "closeZoomNoPressureFieldOfView": {
          "type": "number",
          "title": "Close Zoom No Pressure Field Of View"
        },
        "closeZoomRenderScaleMin": {
          "type": "number",
          "title": "Close Zoom Render Scale Min"
        }
      },
      "additionalProperties": false,
      "title": "Zoom Settings"
    },
    "developerPixelOptimization": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled"
        },
        "renderScaleCap": {
          "type": "number",
          "title": "Render Scale Cap"
        },
        "minimumTextureMipmapLimit": {
          "type": "integer",
          "title": "Minimum Texture Mipmap Limit"
        },
        "forceDisableAntiAliasing": {
          "type": "boolean",
          "title": "Force Disable Anti Aliasing"
        },
        "forceDisableAnisotropicFiltering": {
          "type": "boolean",
          "title": "Force Disable Anisotropic Filtering"
        }
      },
      "additionalProperties": false,
      "title": "Developer Pixel Optimization"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/height-map.schema.json",
  "title": "Moyva — Height Map Settings",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.API.HeightMapSettings. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.height-map"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "height-map"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "heightLayers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "tileID": {
            "type": [
              "string",
              "null"
            ],
            "title": "Tile ID",
            "description": "Базовий ID тайла для цього інтервалу висоти."
          },
          "tileIDChance": {
            "type": "number",
            "title": "Tile ID Chance",
            "description": "Ймовірність вибору базового тайла (0–1).",
            "minimum": 0.0,
            "maximum": 1.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 1.0
          },
          "weightedVariants": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "tileID": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "title": "Tile ID",
                  "description": "ID тайла."
                },
                "chance": {
                  "type": "number",
                  "title": "Chance",
                  "description": "Ймовірність вибору цього тайла (0–1). Сума всіх шансів у шарі не має перевищувати 1.",
                  "minimum": 0.0,
                  "maximum": 1.0,
                  "x-moyva-editorMinimum": 0.0,
                  "x-moyva-editorMaximum": 1.0
                }
              },
              "additionalProperties": false
            },
            "title": "Weighted Variants",
            "description": "Варіанти тайлів з індивідуальними шансами для випадкового вибору."
          },
          "variantTileIDs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": "Variant Tile I Ds"
          },
          "minHeight": {
            "type": "number",
            "title": "Min Height",
            "description": "Нижня межа висоти для цього шару."
          },
          "maxHeight": {
            "type": "number",
            "title": "Max Height",
            "description": "Верхня межа висоти для цього шару."
          }
        },
        "additionalProperties": false
      },
      "title": "Height Layers",
      "description": "Набір шарів висоти, які перетворюють числову карту висот у базову карту тайлів. Кожен шар задає інтервал висот і Tile ID, що має використовуватись у цьому інтервалі."
    }
  }
}

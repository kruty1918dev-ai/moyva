{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/atlas-tile-set.schema.json",
  "title": "Moyva — Atlas Tile Set Config",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.AtlasTileSetConfig. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.atlas-tile-set"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "atlas-tile-set"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "heightQuantumMeters": {
      "type": "number",
      "title": "Height Quantum Meters",
      "description": "Terrace quantum used by the pack, meters.",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "lowBorderDropMaxMeters": {
      "type": "number",
      "title": "Low Border Drop Max Meters",
      "description": "Open-side drops up to this depth use _low prefab variants.",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "stairModuleRiseMeters": {
      "type": "number",
      "title": "Stair Module Rise Meters",
      "description": "Rise covered by one authored stair module.",
      "minimum": 0.01,
      "x-moyva-editorMinimum": 0.01
    },
    "stairMidSurfaceDropMeters": {
      "type": "number",
      "title": "Stair Mid Surface Drop Meters",
      "description": "Walking surface used for traversal is this far below the module top.",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "overlaySurfaceOffsetMeters": {
      "type": "number",
      "title": "Overlay Surface Offset Meters",
      "description": "Surface offset for road/footpath overlay quads above the terrain surface.",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "themes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "themeId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Theme Id",
            "description": "Pack theme id, e.g. grass, sand, rock_cliff."
          },
          "tileTypeId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Tile Type Id",
            "description": "Semantic tile id this theme renders (moyva.tile-type id)."
          },
          "preset": {
            "type": [
              "object",
              "null"
            ],
            "description": "Dual-grid preset holding the five high-variant prefabs.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Preset"
          },
          "cornerLow": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Corner Low"
          },
          "edgeLow": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Edge Low"
          },
          "interiorLow": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Interior Low"
          },
          "mergedLow": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Merged Low"
          },
          "fillLow": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Fill Low"
          },
          "stair": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Stair"
          }
        },
        "additionalProperties": false
      },
      "title": "Themes"
    }
  }
}

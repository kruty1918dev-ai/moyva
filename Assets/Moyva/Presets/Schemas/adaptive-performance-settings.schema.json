            },
            "antiAliasing": {
              "type": "integer",
              "title": "Anti Aliasing"
            },
            "vSync": {
              "type": "boolean",
              "title": "V Sync"
            },
            "shadows": {
              "type": "boolean",
              "title": "Shadows"
            },
            "anisotropicFiltering": {
              "type": "boolean",
              "title": "Anisotropic Filtering"

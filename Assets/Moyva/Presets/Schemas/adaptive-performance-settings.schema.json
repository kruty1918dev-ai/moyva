                "Auto",
                "Performance",
                "Balanced",
                "Quality",
                "Custom"
              ],
              "x-flags": false,
              "title": "Profile"
            },
            "targetFrameRate": {
              "type": "integer",
              "title": "Target Frame Rate"
            },
            "renderScale": {

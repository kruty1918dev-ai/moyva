          "minimum": 0.1,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.1,
          "x-moyva-editorMaximum": 1.0
        },
        "deployEase": {
          "type": "string",
          "pattern": "^(?:-?\\d+|(?:Linear|SmoothStep|InQuad|OutQuad|InOutQuad|InCubic|OutCubic|InOutCubic|OutBackSoft))$",
          "x-enumNames": [
            "Linear",
            "SmoothStep",
            "InQuad",
            "OutQuad",
            "InOutQuad",
            "InCubic",
            "OutCubic",
            "InOutCubic",
            "OutBackSoft"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/gameplay-motion.schema.json",
  "title": "Moyva — Gameplay Motion Config",
  "description": "JSON source of truth для Kruty1918.Moyva.Animations.API.GameplayMotionConfig. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.gameplay-motion"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "gameplay-motion"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "unitLocomotion": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "acceleration": {
          "type": "number",
          "title": "Acceleration",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "deceleration": {
          "type": "number",
          "title": "Deceleration",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "turnSpeedDegPerSec": {
          "type": "number",
          "title": "Turn Speed Deg Per Sec",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "faceTravelDirection": {
          "type": "boolean",
          "title": "Face Travel Direction"
        },
        "bobAmplitude": {
          "type": "number",
          "title": "Bob Amplitude",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "bobFrequency": {
          "type": "number",
          "title": "Bob Frequency",
          "description": "Bob cycles per world unit travelled — speed-scaled footfall rhythm.",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "cornerAnticipation": {
          "type": "number",
          "title": "Corner Anticipation",
          "description": "Heading anticipation: fraction of a tile before a corner where facing starts to blend toward the next segment.",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        }
      },
      "additionalProperties": false,
      "title": "Unit Locomotion"
    },

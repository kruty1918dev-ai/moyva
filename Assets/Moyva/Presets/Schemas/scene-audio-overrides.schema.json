{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/scene-audio-overrides.schema.json",
  "title": "Moyva — Scene Audio Overrides SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Audio.Runtime.SceneAudioOverridesSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.scene-audio-overrides"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "scene-audio-overrides"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "overrides": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "sceneName": {
            "type": [
              "string",
              "null"
            ],
            "title": "Scene Name"
          },
          "soundKey": {
            "type": [
              "string",
              "null"
            ],
            "title": "Sound Key"
          },
          "overrideVolume": {
            "type": "boolean",
            "title": "Override Volume"
          },
          "volume": {
            "type": "number",
            "title": "Volume",
            "minimum": 0.0,
            "maximum": 1.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 1.0
          },
          "overridePitch": {
            "type": "boolean",
            "title": "Override Pitch"
          },
          "pitch": {
            "type": "number",
            "title": "Pitch",
            "minimum": -3.0,
            "maximum": 3.0,
            "x-moyva-editorMinimum": -3.0,
            "x-moyva-editorMaximum": 3.0
          },
          "overrideMixerGroup": {
            "type": "boolean",
            "title": "Override Mixer Group"
          },
          "mixerGroup": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Mixer Group"
          },
          "overrideLoop": {
            "type": "boolean",
            "title": "Override Loop"
          },
          "loop": {
            "type": "boolean",
            "title": "Loop"
          },
          "overrideSpatialBlend": {
            "type": "boolean",
            "title": "Override Spatial Blend"
          },
          "spatialBlend": {
            "type": "number",
            "title": "Spatial Blend",
            "minimum": 0.0,
            "maximum": 1.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 1.0
          },
          "overridePriority": {
            "type": "boolean",
            "title": "Override Priority"
          },
          "priority": {
            "type": "integer",
            "title": "Priority",
            "minimum": 0.0,
            "maximum": 256.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 256.0
          },
          "playOnAwake": {
            "type": "boolean",
            "title": "Play On Awake"
          }
        },
        "additionalProperties": false
      },
      "title": "Overrides"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/game-session-config.schema.json",
  "title": "Moyva — Game Session Config SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Faction.Runtime.GameSessionConfigSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.game-session-config"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "game-session-config"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "factions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "factionId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Faction Id",
            "description": "Унікальний рядковий ідентифікатор фракції, напр. 'player_0', 'bot_1'."
          },
          "type": {
            "type": "string",
            "pattern": "^(?:-?\\d+|(?:Human|Bot|Network))$",
            "x-enumNames": [
              "Human",
              "Bot",
              "Network"
            ],
            "x-flags": false,
            "title": "Type"
          },
          "defaultUnitTypeId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Default Unit Type Id",
            "description": "TypeId юніта, який бот спавнить на старті, напр. 'warrior'."
          },
          "startPosition": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "title": "Start Position"
          },
          "teamColor": {
            "type": "object",
            "properties": {
              "r": {
                "type": "number"
              },
              "g": {
                "type": "number"
              },
              "b": {
                "type": "number"
              },
              "a": {
                "type": "number"
              }
            },
            "required": [
              "r",
              "g",
              "b",
              "a"
            ],
            "additionalProperties": false,
            "title": "Team Color"
          }
        },
        "additionalProperties": false
      },
      "title": "Factions"
    }
  }
}

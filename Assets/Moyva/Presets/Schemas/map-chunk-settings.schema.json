{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/map-chunk-settings.schema.json",
  "title": "Moyva — Map Chunk Settings SO",
  "description": "JSON source of truth для Kruty1918.Moyva.MapChunks.API.MapChunkSettingsSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.map-chunk-settings"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "map-chunk-settings"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "chunkSize": {
      "type": "integer",
      "title": "Chunk Size",
      "description": "Розмір чанка у grid-тайлах: 16 означає 16x16 тайлів. Крайові неповні чанки заборонені; розмір мапи обрізається до повних 16x16 чанків.",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "enableCameraCulling": {
      "type": "boolean",
      "title": "Enable Camera Culling"
    },
    "cameraCullingIntervalSeconds": {
      "type": "number",
      "title": "Camera Culling Interval Seconds",
      "minimum": 0.02,
      "x-moyva-editorMinimum": 0.02
    },
    "cameraCullingPaddingCells": {
      "type": "number",
      "title": "Camera Culling Padding Cells",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "enableVisualChunkDiscovery": {
      "type": "boolean",
      "title": "Enable Visual Chunk Discovery"
    },
    "enableVisualChunkPartitioning": {
      "type": "boolean",
      "title": "Enable Visual Chunk Partitioning"
    },
    "repeatVisualChunkDiscoveryDuringStartup": {
      "type": "boolean",
      "title": "Repeat Visual Chunk Discovery During Startup",
      "description": "Повторювати повний visual discovery scan протягом startup-вікна."
    },
    "repeatVisualChunkPartitioningDuringStartup": {
      "type": "boolean",
      "title": "Repeat Visual Chunk Partitioning During Startup",
      "description": "Повторювати повний visual partition scan протягом startup-вікна."
    },
    "visualDiscoveryIntervalSeconds": {
      "type": "number",
      "title": "Visual Discovery Interval Seconds",
      "minimum": 0.05,
      "x-moyva-editorMinimum": 0.05
    },
    "visualPartitionDurationSeconds": {
      "type": "number",
      "title": "Visual Partition Duration Seconds",
      "minimum": 0.1,
      "x-moyva-editorMinimum": 0.1
    },
    "visualDiscoveryLayerMask": {
      "type": "integer",
      "title": "Visual Discovery Layer Mask"
    },
    "ignoredRendererNameTokens": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "Ignored Renderer Name Tokens"
    }
  }
}

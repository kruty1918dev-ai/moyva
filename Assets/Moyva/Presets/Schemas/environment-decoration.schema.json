{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/environment-decoration.schema.json",
  "title": "Moyva — Environment Decoration Config",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.API.EnvironmentDecorationConfig. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.environment-decoration"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "environment-decoration"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "enabled": {
      "type": "boolean",
      "title": "Enabled"
    },
    "globalDensity": {
      "type": "number",
      "title": "Global Density",
      "minimum": 0.0,
      "maximum": 2.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 2.0
    },
    "seedOffset": {
      "type": "integer",
      "title": "Seed Offset"
    },
    "maxObjectsPerTile": {
      "type": "integer",
      "title": "Max Objects Per Tile",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "clusterStrength": {
      "type": "number",
      "title": "Cluster Strength",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "clusterRadius": {
      "type": "integer",
      "title": "Cluster Radius",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "typeDensities": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "treeDensity": {
          "type": "number",
          "title": "Tree Density",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "bushDensity": {
          "type": "number",
          "title": "Bush Density",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "grassDensity": {
          "type": "number",
          "title": "Grass Density",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "flowerDensity": {
          "type": "number",
          "title": "Flower Density",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "rockDensity": {
          "type": "number",
          "title": "Rock Density",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        },
        "waterPlantDensity": {
          "type": "number",
          "title": "Water Plant Density",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 1.0
        }
      },
      "additionalProperties": false,
      "title": "Type Densities"
    },
    "biomeRules": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "grassland": {
          "type": "number",
          "title": "Grassland",
          "minimum": 0.0,
          "maximum": 3.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 3.0
        },
        "forest": {
          "type": "number",
          "title": "Forest",
          "minimum": 0.0,
          "maximum": 3.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 3.0
        },
        "rocky": {
          "type": "number",
          "title": "Rocky",
          "minimum": 0.0,
          "maximum": 3.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 3.0
        },
        "coast": {
          "type": "number",
          "title": "Coast",
          "minimum": 0.0,
          "maximum": 3.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 3.0
        },
        "water": {
          "type": "number",
          "title": "Water",
          "minimum": 0.0,
          "maximum": 3.0,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 3.0
        }
      },
      "additionalProperties": false,
      "title": "Biome Rules"
    },
    "exclusions": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "buildingExclusionRadius": {
          "type": "integer",
          "title": "Building Exclusion Radius",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "settlementExclusionRadius": {
          "type": "integer",
          "title": "Settlement Exclusion Radius",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "suppressWaterDecorations": {
          "type": "boolean",
          "title": "Suppress Water Decorations"
        },
        "shorelineExclusionCells": {
          "type": "integer",
          "title": "Shoreline Exclusion Cells",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        }
      },
      "additionalProperties": false,
      "title": "Exclusions"
    },
    "visualVariation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "enableRotation": {
          "type": "boolean",
          "title": "Enable Rotation"
        },
        "enableScaleVariation": {
          "type": "boolean",
          "title": "Enable Scale Variation"
        },
        "minScale": {
          "type": "number",
          "title": "Min Scale",
          "minimum": 0.5,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.5,
          "x-moyva-editorMaximum": 1.0
        },
        "maxScale": {
          "type": "number",
          "title": "Max Scale",
          "minimum": 1.0,
          "maximum": 1.5,
          "x-moyva-editorMinimum": 1.0,
          "x-moyva-editorMaximum": 1.5
        },
        "maxPositionOffset": {
          "type": "number",
          "title": "Max Position Offset",
          "minimum": 0.0,
          "maximum": 0.5,
          "x-moyva-editorMinimum": 0.0,
          "x-moyva-editorMaximum": 0.5
        },
        "alignToSurface": {
          "type": "boolean",
          "title": "Align To Surface"
        }
      },
      "additionalProperties": false,
      "title": "Visual Variation"
    },
    "footprint": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "validateHeavyFootprints": {
          "type": "boolean",
          "title": "Validate Heavy Footprints"
        },
        "maxShiftCells": {
          "type": "number",
          "title": "Max Shift Cells",
          "minimum": 0.0,
          "x-moyva-editorMinimum": 0.0
        },
        "maxGroundDeltaMeters": {
          "type": "number",
          "title": "Max Ground Delta Meters",
          "minimum": 0.01,
          "x-moyva-editorMinimum": 0.01
        },
        "footprintShrink": {
          "type": "number",
          "title": "Footprint Shrink",
          "minimum": 0.3,
          "maximum": 1.0,
          "x-moyva-editorMinimum": 0.3,
          "x-moyva-editorMaximum": 1.0
        }
      },
      "additionalProperties": false,
      "title": "Footprint"
    },
    "assetPools": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "Asset Pools"
    },
    "layers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ],
            "title": "Type"
          },
          "weight": {
            "type": "number",
            "title": "Weight",
            "minimum": 0.0,
            "maximum": 2.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 2.0
          },
          "maxPerTile": {
            "type": "integer",
            "title": "Max Per Tile",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          },
          "biomeBoost": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "number"
            },
            "title": "Biome Boost"
          },
          "waterAffinity": {
            "type": "string",
            "pattern": "^(?:-?\\d+|(?:Any|Avoid|Prefer|Require))$",
            "x-enumNames": [
              "Any",
              "Avoid",
              "Prefer",
              "Require"
            ],
            "x-flags": false,
            "title": "Water Affinity"
          },
          "waterRadius": {
            "type": "integer",
            "title": "Water Radius",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          },
          "waterBoost": {
            "type": "number",
            "title": "Water Boost",
            "minimum": 0.0,
            "maximum": 5.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 5.0
          },
          "forestAffinity": {
            "type": "string",
            "pattern": "^(?:-?\\d+|(?:Any|Interior|Edge|Avoid))$",
            "x-enumNames": [
              "Any",
              "Interior",
              "Edge",
              "Avoid"
            ],
            "x-flags": false,
            "title": "Forest Affinity"
          },
          "forestEdgeRadius": {
            "type": "integer",
            "title": "Forest Edge Radius",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          },
          "nearTreeBoost": {
            "type": "number",
            "title": "Near Tree Boost",
            "minimum": 0.0,
            "maximum": 2.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 2.0
          },
          "nearTreeRadius": {
            "type": "integer",
            "title": "Near Tree Radius",
            "minimum": 1.0,
            "x-moyva-editorMinimum": 1.0
          },
          "skipObjectCells": {
            "type": "boolean",
            "title": "Skip Object Cells"
          },
          "shorelineExclusion": {
            "type": "boolean",
            "title": "Shoreline Exclusion"
          },
          "validateFootprint": {
            "type": "boolean",
            "title": "Validate Footprint"
          },
          "feedsTreeAffinity": {
            "type": "boolean",
            "title": "Feeds Tree Affinity"
          },
          "maxSlopeMeters": {
            "type": "number",
            "title": "Max Slope Meters",
            "minimum": 0.0,
            "x-moyva-editorMinimum": 0.0
          },
          "minScale": {
            "type": "number",
            "title": "Min Scale",
            "minimum": 0.0,
            "maximum": 3.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 3.0
          },
          "maxScale": {
            "type": "number",
            "title": "Max Scale",
            "minimum": 0.0,
            "maximum": 3.0,
            "x-moyva-editorMinimum": 0.0,
            "x-moyva-editorMaximum": 3.0
          },
          "yOffset": {
            "type": "number",
            "title": "Y Offset"
          }
        },
        "additionalProperties": false
      },
      "title": "Layers"
    }
  }
}

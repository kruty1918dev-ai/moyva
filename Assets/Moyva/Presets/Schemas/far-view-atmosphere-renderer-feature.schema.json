{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/far-view-atmosphere-renderer-feature.schema.json",
  "title": "Moyva — Far View Atmosphere Renderer Feature",
  "description": "JSON source of truth для Kruty1918.Moyva.Visuals.FarViewAtmosphereRendererFeature. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.far-view-atmosphere-renderer-feature"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "far-view-atmosphere-renderer-feature"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "shader": {
      "type": [
        "object",
        "null"
      ],
      "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
      "properties": {
        "$asset": {
          "type": "string",
          "title": "Asset ID"
        },
        "editorPath": {
          "type": "string",
          "description": "Editor-only path для діагностики/регенерації catalog."
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "$asset"
      ],
      "title": "Shader"
    },
    "renderPassEvent": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:BeforeRendering|BeforeRenderingShadows|AfterRenderingShadows|BeforeRenderingPrePasses|AfterRenderingPrePasses|BeforeRenderingGbuffer|AfterRenderingGbuffer|BeforeRenderingDeferredLights|AfterRenderingDeferredLights|BeforeRenderingOpaques|AfterRenderingOpaques|BeforeRenderingSkybox|AfterRenderingSkybox|BeforeRenderingTransparents|AfterRenderingTransparents|BeforeRenderingPostProcessing|AfterRenderingPostProcessing|AfterRendering))$",
      "x-enumNames": [
        "BeforeRendering",
        "BeforeRenderingShadows",
        "AfterRenderingShadows",
        "BeforeRenderingPrePasses",
        "AfterRenderingPrePasses",
        "BeforeRenderingGbuffer",
        "AfterRenderingGbuffer",
        "BeforeRenderingDeferredLights",
        "AfterRenderingDeferredLights",
        "BeforeRenderingOpaques",
        "AfterRenderingOpaques",
        "BeforeRenderingSkybox",
        "AfterRenderingSkybox",
        "BeforeRenderingTransparents",
        "AfterRenderingTransparents",
        "BeforeRenderingPostProcessing",
        "AfterRenderingPostProcessing",
        "AfterRendering"
      ],
      "x-flags": false,
      "title": "Render Pass Event",
      "description": "Must stay AFTER the Fog of War composite so atmosphere can only restyle already-visible pixels."
    },
    "applyInSceneView": {
      "type": "boolean",
      "title": "Apply In Scene View"
    },
    "applyInSceneViewDuringPlay": {
      "type": "boolean",
      "title": "Apply In Scene View During Play"
    },
    "debugView": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:Final|Weight|HazeOnly|VeilOnly|FlattenOnly|EyeDepth))$",
      "x-enumNames": [
        "Final",
        "Weight",
        "HazeOnly",
        "VeilOnly",
        "FlattenOnly",
        "EyeDepth"
      ],
      "x-flags": false,
      "title": "Debug View"
    },
    "m_Active": {
      "type": "boolean",
      "title": "Active"
    }
  }
}

    },
    "enableResourceDebug": {
      "type": "boolean",
      "title": "Enable Resource Debug"
    },
    "enableVisualDebug": {
      "type": "boolean",
      "title": "Enable Visual Debug"
    },
    "enableWallDebug": {
      "type": "boolean",

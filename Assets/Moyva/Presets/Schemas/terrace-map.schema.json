{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/terrace-map.schema.json",
  "title": "Moyva — Terrace Map Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.TerraceMapNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.terrace-map"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "terrace-map"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "steps": {
      "type": "integer",
      "title": "Steps",
      "description": "Кількість дискретних рівнів терас.",
      "minimum": 2.0,
      "maximum": 64.0,
      "x-moyva-editorMinimum": 2.0,
      "x-moyva-editorMaximum": 64.0
    },
    "strength": {
      "type": "number",
      "title": "Strength",
      "description": "0 залишає початкову карту, 1 застосовує повну терасизацію.",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-moyva-editorMinimum": 0.0,
      "x-moyva-editorMaximum": 1.0
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

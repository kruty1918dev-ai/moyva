{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/edge-mask.schema.json",
  "title": "Moyva — Edge Mask Node",
  "description": "JSON source of truth для Kruty1918.Moyva.Generator.Runtime.Nodes.ObjectPlacement.EdgeMaskNode. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.edge-mask"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "edge-mask"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "distanceFromEdge": {
      "type": "integer",
      "title": "Distance From Edge",
      "description": "Повна інтенсивність на відстані від краю маски, у клітинах.",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "falloff": {
      "type": "integer",
      "title": "Falloff",
      "description": "Додаткова м’яка відстань спаду, у клітинах.",
      "minimum": 0.0,
      "x-moyva-editorMinimum": 0.0
    },
    "invert": {
      "type": "boolean",
      "title": "Invert",
      "description": "Виводить інтерір біля краю замість смуги краю."
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Node Id"
    },
    "editorPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "title": "Editor Position"
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Layer Id"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/economy-caravan-template.schema.json",
  "title": "Moyva — Economy Caravan Template",
  "description": "JSON source of truth для Kruty1918.Moyva.Economy.API.EconomyCaravanTemplate. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.economy-caravan-template"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "economy-caravan-template"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "templateId": {
      "type": [
        "string",
        "null"
      ],
      "title": "Template Id"
    },
    "allowedResourceIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "Allowed Resource Ids"
    },
    "capacity": {
      "type": "integer",
      "title": "Capacity"
    },
    "maxWeightGrams": {
      "type": "integer",
      "title": "Max Weight Grams",
      "minimum": 1.0,
      "x-moyva-editorMinimum": 1.0
    },
    "defaultPriority": {
      "type": "integer",
      "title": "Default Priority"
    },
    "useLoopDelivery": {
      "type": "boolean",
      "title": "Use Loop Delivery"
    }
  }
}

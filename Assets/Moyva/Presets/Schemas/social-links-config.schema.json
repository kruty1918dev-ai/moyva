{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/social-links-config.schema.json",
  "title": "Moyva — Social Links Config SO",
  "description": "JSON source of truth для Kruty1918.Moyva.HomeMenu.Runtime.SocialLinksConfigSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.social-links-config"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "social-links-config"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "entries": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "title": "Id"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "title": "Display Name"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "title": "Url"
          },
          "icon": {
            "type": [
              "object",
              "null"
            ],
            "description": "Opaque Unity asset reference. Gameplay values не зберігаються в Unity asset.",
            "properties": {
              "$asset": {
                "type": "string",
                "title": "Asset ID"
              },
              "editorPath": {
                "type": "string",
                "description": "Editor-only path для діагностики/регенерації catalog."
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "$asset"
            ],
            "title": "Icon"
          }
        },
        "additionalProperties": false
      },
      "title": "Entries"
    }
  }
}

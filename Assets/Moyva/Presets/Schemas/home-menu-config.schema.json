{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/home-menu-config.schema.json",
  "title": "Moyva — Home Menu Config SO",
  "description": "JSON source of truth для Kruty1918.Moyva.HomeMenu.Runtime.HomeMenuConfigSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.home-menu-config"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "home-menu-config"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "gameplaySceneName": {
      "type": [
        "string",
        "null"
      ],
      "title": "Gameplay Scene Name"
    },
    "homeMenuSceneName": {
      "type": [
        "string",
        "null"
      ],
      "title": "Home Menu Scene Name"
    },
    "minPreloadSeconds": {
      "type": "number",
      "title": "Min Preload Seconds"
    },
    "sceneActivationDelay": {
      "type": "number",
      "title": "Scene Activation Delay"
    },
    "menuSimulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mapSide": { "type": "integer", "minimum": 16, "maximum": 48 },
        "mobileMapSide": { "type": "integer", "minimum": 16, "maximum": 48 },
        "textureEdge": { "type": "integer", "minimum": 256, "maximum": 1280 },
        "mobileTextureEdge": { "type": "integer", "minimum": 256, "maximum": 1280 },
        "framesPerSecond": { "type": "integer", "minimum": 10, "maximum": 30 },
        "mobileFramesPerSecond": { "type": "integer", "minimum": 10, "maximum": 30 },
        "maxUnits": { "type": "integer", "minimum": 2, "maximum": 12 },
        "turnSeconds": { "type": "number", "minimum": 1, "maximum": 10 },
        "shotSeconds": { "type": "number", "minimum": 4, "maximum": 15 },
        "cycleSeconds": { "type": "number", "minimum": 45, "maximum": 180 }
      }
    },
    "useUnityHtmlShell": {
      "type": "boolean",
      "title": "Use Unity HTML Shell",
      "default": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/win-condition.schema.json",
  "title": "Moyva — Win Condition SO",
  "description": "JSON source of truth для Kruty1918.Moyva.GameMode.API.WinConditionSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.win-condition"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "win-condition"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "condition": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:EliminateAllEnemies|ControlPoints|Survival|Custom))$",
      "x-enumNames": [
        "EliminateAllEnemies",
        "ControlPoints",
        "Survival",
        "Custom"
      ],
      "x-flags": false,
      "title": "Condition"
    },
    "controlPointsRequired": {
      "type": "integer",
      "title": "Control Points Required"
    },
    "survivalTimeSeconds": {
      "type": "number",
      "title": "Survival Time Seconds"
    }
  }
}

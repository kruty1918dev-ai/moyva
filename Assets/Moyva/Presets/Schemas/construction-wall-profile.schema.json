{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/construction-wall-profile.schema.json",
  "title": "Moyva — Construction Wall Profile SO",
  "description": "JSON source of truth для Kruty1918.Moyva.Construction.API.ConstructionWallProfileSO. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.construction-wall-profile"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "construction-wall-profile"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "allowGateReplacement": {
      "type": "boolean",
      "title": "Allow Gate Replacement"
    },
    "gateRequiresHorizontalWall": {
      "type": "boolean",
      "title": "Gate Requires Horizontal Wall"
    },
    "allowWallPathThroughExistingWalls": {
      "type": "boolean",
      "title": "Allow Wall Path Through Existing Walls"
    },
    "allowWallPathThroughPendingWalls": {
      "type": "boolean",
      "title": "Allow Wall Path Through Pending Walls"
    },
    "allowWallPathThroughGates": {
      "type": "boolean",
      "title": "Allow Wall Path Through Gates"
    },
    "wallPathMode": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:OrthogonalOnly|ExistingWallsPreferred))$",
      "x-enumNames": [
        "OrthogonalOnly",
        "ExistingWallsPreferred"
      ],
      "x-flags": false,
      "title": "Wall Path Mode"
    },
    "showWallHandles": {
      "type": "boolean",
      "title": "Show Wall Handles"
    }
  }
}

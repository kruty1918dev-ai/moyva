{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyva.local/schemas/economy-warehouse-policy.schema.json",
  "title": "Moyva — Economy Warehouse Policy",
  "description": "JSON source of truth для Kruty1918.Moyva.Economy.API.EconomyWarehousePolicy. Згенеровано з фактичного Unity serialization contract; runtime читає JSON напряму.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "title": "JSON Schema"
    },
    "schema": {
      "const": "moyva.economy-warehouse-policy"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Стабільний ID",
      "description": "Стабільний ідентифікатор. Використовуйте дефіси; ID не залежить від filename або C# class name."
    },
    "model": {
      "const": "economy-warehouse-policy"
    },
    "migration": {
      "type": "object",
      "additionalProperties": true
    },
    "warehouseType": {
      "type": "string",
      "pattern": "^(?:-?\\d+|(?:FoodWarehouse|MaterialsWarehouse))$",
      "x-enumNames": [
        "FoodWarehouse",
        "MaterialsWarehouse"
      ],
      "x-flags": false,
      "title": "Warehouse Type"
    },
    "entries": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "resourceId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Resource Id"
          },
          "consumptionAllowed": {
            "type": "boolean",
            "title": "Consumption Allowed"
          },
          "priority": {
            "type": "integer",
            "title": "Priority"
          },
          "reserveAmount": {
            "type": "integer",
            "title": "Reserve Amount"
          }
        },
        "additionalProperties": false
      },
      "title": "Entries"
    }
  }
}

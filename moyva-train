#!/usr/bin/env bash
set -euo pipefail
PROJECT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${MOYVA_PYTHON:-python3}"
if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo "Python not found. Set MOYVA_PYTHON to Python 3.10.1–3.10.12." >&2
  exit 2
fi
exec "$PYTHON" "$PROJECT/tools/ai/moyva_train.py" "$@"
